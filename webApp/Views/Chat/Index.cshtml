@model IEnumerable<dynamic>
@{
    ViewBag.Title = "Chat";
}

<nav class="flex border-b">
    <a href="@Url.Action("Index", "Chat")" class="flex-grow text-center py-3 hover:bg-gray-100 font-semibold border-b-4 border-blue-500">Todos</a>
    <a href="@Url.Action("Grupos", "Chat")" class="flex-grow text-center py-3 hover:bg-gray-100 font-semibold">Grupos</a>
</nav>

<form method="get" action="@Url.Action("Index", "Chat")" class="flex justify-center items-center p-3 border-b">
    <input type="text"
           name="busqueda"
           value="@Request.QueryString["busqueda"]"
           placeholder="Buscar Chat"
           class="w-full px-3 py-2 border rounded" />
</form>

<!-- Sección para buscar nuevos usuarios -->
<div class="p-3 border-b bg-gray-50">
    <div class="flex items-center">
        <input type="text"
               id="buscarUsuario"
               placeholder="Buscar usuario para chatear..."
               class="flex-grow px-3 py-2 border rounded-l" />
        <button onclick="buscarUsuarios()" class="px-4 py-2 bg-blue-500 text-white rounded-r hover:bg-blue-600">
            Buscar
        </button>
    </div>
    <div id="resultadosUsuarios" class="mt-2 hidden"></div>
</div>

<div class="flex h-screen max-h-[700px] border rounded shadow overflow-hidden">
    <div class="flex-grow overflow-y-auto">
        @if (Model != null && Model.Any())
        {
            foreach (var conversacion in Model)
            {
                var otroUsuario = conversacion.OtroUsuarioObj;

                var fotoBase64 = otroUsuario != null && otroUsuario.Foto_perfil != null
                    ? "data:image/png;base64," + Convert.ToBase64String(otroUsuario.Foto_perfil)
                    : null;

                <a href="@Url.Action("ChatMensajes", "Chat", new { idOtroUsuario = conversacion.OtroUsuario })"
                   class="flex items-center px-4 py-3 hover:bg-gray-100 cursor-pointer border-b">
                    <div class="flex-shrink-0 w-14 h-14 rounded-full overflow-hidden border border-gray-300">
                        @if (fotoBase64 != null)
                        {
                            <img src="@fotoBase64" alt="Foto perfil" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="flex items-center justify-center w-full h-full bg-gray-200 text-gray-400 text-xl font-semibold">
                                <span>@(otroUsuario != null ? otroUsuario.Nombre.Substring(0,1).ToUpper() : "?")</span>
                            </div>
                        }
                    </div>
                    <div class="ml-4 flex flex-col flex-grow">
                        <span class="font-semibold text-gray-900">
                            @(otroUsuario != null ? otroUsuario.Nombre + " " + otroUsuario.Apellido : "Usuario desconocido")
                        </span>
                        @if (conversacion.UltimoMensaje != null && conversacion.UltimoMensaje.Mensaje != null)
                        {
                            <span class="text-sm text-gray-500">
                                @(conversacion.UltimoMensaje.Mensaje.contenidoMensaje.Length > 50
                                    ? conversacion.UltimoMensaje.Mensaje.contenidoMensaje.Substring(0, 50) + "..."
                                    : conversacion.UltimoMensaje.Mensaje.contenidoMensaje)
                            </span>
                        }
                        else
                        {
                            <span class="text-sm text-gray-500">Sin mensajes</span>
                        }
                    </div>
                    @if (conversacion.UltimoMensaje != null && conversacion.UltimoMensaje.Mensaje != null)
                    {
                        <div class="text-xs text-gray-400">
                            @conversacion.UltimoMensaje.Mensaje.fechaHora.ToString("HH:mm")
                        </div>
                    }
                </a>
            }
        }
        else
        {
            <div class="flex items-center justify-center h-full text-gray-500">
                <div class="text-center">
                    <p class="text-lg mb-2">No tienes conversaciones</p>
                    <p class="text-sm">Busca un usuario para empezar a chatear</p>
                </div>
            </div>
        }
    </div>
</div>

<script>
function buscarUsuarios() {
    var termino = document.getElementById('buscarUsuario').value;
    if (termino.length < 2) return;

    fetch('@Url.Action("BuscarUsuarios", "Chat")?termino=' + encodeURIComponent(termino))
        .then(response => response.json())
        .then(data => {
            var div = document.getElementById('resultadosUsuarios');
            if (data.length > 0) {
                var html = '<div class="bg-white border rounded shadow-lg max-h-40 overflow-y-auto">';
                data.forEach(function(usuario) {
                    html += '<a href="@Url.Action("ChatMensajes", "Chat")?idOtroUsuario=' + usuario.id + '" class="block px-3 py-2 hover:bg-gray-100 border-b">';
                    html += '<div class="font-semibold">' + usuario.nombre + '</div>';
                    html += '<div class="text-sm text-gray-500">' + usuario.email + '</div>';
                    html += '</a>';
                });
                html += '</div>';
                div.innerHTML = html;
                div.classList.remove('hidden');
            } else {
                div.classList.add('hidden');
            }
        });
}

// Ocultar resultados cuando se hace clic fuera
document.addEventListener('click', function(e) {
    if (!e.target.closest('#buscarUsuario') && !e.target.closest('#resultadosUsuarios')) {
        document.getElementById('resultadosUsuarios').classList.add('hidden');
    }
});
</script>