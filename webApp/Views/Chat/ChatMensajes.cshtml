@model IEnumerable<SmartSys.Models.usuario_mensajes>
@{
    ViewBag.Title = "Chat con " + ViewBag.OtroUsuario.Nombre;
    var otroUsuario = ViewBag.OtroUsuario as SmartSys.Models.Usuario;
    var idUsuarioActual = Convert.ToInt64(Session["idUsuario"]);
}

<div class="flex h-screen max-h-[800px] flex-col border rounded shadow overflow-hidden">
    <!-- Header del chat -->
    <div class="flex items-center px-4 py-3 border-b bg-gray-50">
        <a href="@Url.Action("Index", "Chat")" class="mr-3 text-blue-500 hover:text-blue-700">
            ← Volver
        </a>
        <div class="flex-shrink-0 w-10 h-10 rounded-full overflow-hidden border border-gray-300">
            @{
                var fotoBase64 = otroUsuario.Foto_perfil != null
                    ? "data:image/png;base64," + Convert.ToBase64String(otroUsuario.Foto_perfil)
                    : null;
            }
            @if (fotoBase64 != null)
            {
                <img src="@fotoBase64" alt="Foto perfil" class="w-full h-full object-cover" />
            }
            else
            {
                <div class="flex items-center justify-center w-full h-full bg-gray-200 text-gray-400 text-sm font-semibold">
                    <span>@(otroUsuario.Nombre.Substring(0,1).ToUpper())</span>
                </div>
            }
        </div>
        <div class="ml-3">
            <h2 class="font-semibold text-gray-900">@otroUsuario.Nombre @otroUsuario.Apellido</h2>
            <p class="text-sm text-gray-500">@otroUsuario.CorreoElectronico</p>
        </div>
    </div>

    <!-- Área de mensajes -->
    <div class="flex-grow overflow-y-auto p-4 space-y-3" id="mensajesContainer">
        @if (Model.Any())
        {
            foreach (var usuarioMensaje in Model)
            {
                var esPropio = usuarioMensaje.idUsuarioEmisor == idUsuarioActual;
                <div class="flex @(esPropio ? "justify-end" : "justify-start")">
                    <div class="max-w-xs lg:max-w-md px-4 py-2 rounded-lg @(esPropio ? "bg-blue-500 text-white" : "bg-gray-200 text-gray-900")">
                        <p class="text-sm">@usuarioMensaje.Mensaje.contenidoMensaje</p>
                        <p class="text-xs mt-1 @(esPropio ? "text-blue-100" : "text-gray-500")">
                            @usuarioMensaje.Mensaje.fechaHora.ToString("HH:mm")
                        </p>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="flex items-center justify-center h-full text-gray-500">
                <p>No hay mensajes. ¡Inicia la conversación!</p>
            </div>
        }
    </div>

    <!-- Formulario para enviar mensaje -->
    <div class="border-t p-4">
        @using (Html.BeginForm("EnviarMensajePrivado", "Chat", FormMethod.Post, new { @class = "flex space-x-2" }))
        {
            <input type="hidden" name="idOtroUsuario" value="@ViewBag.IdOtroUsuario" />
            <input type="text"
                   name="contenido"
                   placeholder="Escribe tu mensaje..."
                   required
                   class="flex-grow px-3 py-2 border rounded-l focus:outline-none focus:ring-2 focus:ring-blue-500" />
            <button type="submit" class="px-4 py-2 bg-blue-500 text-white rounded-r hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-2 focus:ring-blue-500">
                Enviar
            </button>
        }
    </div>
</div>

<script>
    // Auto-scroll al final de los mensajes
    document.addEventListener('DOMContentLoaded', function () {
        var container = document.getElementById('mensajesContainer');
        container.scrollTop = container.scrollHeight;
    });
</script>