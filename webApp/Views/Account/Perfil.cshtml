@model SmartSys.Models.Usuario
@{
    ViewBag.Title = "Mi Perfil";
}

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 transition-colors duration-300">
    <div class="w-full flex justify-center">
        <div class="max-w-7xl px-6 py-12">

            <div class="text-center mb-12" style="margin-left: 200px;">
                <h1 class="text-3xl font-bold text-gray-800 dark:text-white mb-2">Editar perfil</h1>
                <p class="text-gray-600 dark:text-gray-300">Actualice su información personal</p>
            </div>

            @using (Html.BeginForm("Perfil", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "flex gap-12 justify-center" }))
            {
                @Html.HiddenFor(m => m.IdUsuario)

                <div class="w-80">
                    <div class="flex flex-col items-center">
                        <div class="relative mb-8">
                            @{
                                string base64Image = Model.Foto_perfil != null
                                    ? "data:image/png;base64," + Convert.ToBase64String(Model.Foto_perfil)
                                    : null;
                            }

                            @if (base64Image != null)
                            {
                                <div class="relative">
                                    <img id="previewImagen" src="@base64Image" alt="Foto de perfil"
                                         class="rounded-full object-cover border-4 border-white dark:border-gray-600 shadow-xl brightness-75"
                                         style="width: 320px; height: 320px; min-width: 320px; min-height: 320px;" />
                                    <div class="absolute inset-0 rounded-full flex items-center justify-center">
                                        <label for="fotoPerfil" class="cursor-pointer">
                                            <i class="fa-solid fa-camera text-4xl text-white drop-shadow-lg"></i>
                                        </label>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="avatarPlaceholder" class="rounded-full bg-gradient-to-br from-gray-200 to-gray-300 dark:from-gray-700 dark:to-gray-800 border-4 border-white dark:border-gray-600 shadow-xl relative"
                                     style="width: 320px; height: 320px; min-width: 320px; min-height: 320px;">
                                    <div class="absolute inset-0 flex items-center justify-center">
                                        <i class="fa-solid fa-user text-8xl text-gray-500 dark:text-gray-400 drop-shadow-lg"></i>
                                    </div>
                                    <div class="absolute inset-0 rounded-full flex items-center justify-center">
                                        <label for="fotoPerfil" class="cursor-pointer">
                                            <i class="fa-solid fa-camera text-3xl text-gray-700 dark:text-gray-300 drop-shadow-lg"></i>
                                        </label>
                                    </div>
                                </div>
                                <img id="previewImagen" src="" alt="Foto de perfil"
                                     class="rounded-full object-cover border-4 border-white dark:border-gray-600 shadow-xl hidden"
                                     style="width: 320px; height: 320px; min-width: 320px; min-height: 320px;" />
                            }

                            <input type="file" id="fotoPerfil" name="FotoPerfil" class="hidden" accept="image/*" />
                        </div>

                        <button type="button" class="text-purple-600 dark:text-purple-400 font-medium hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xl"
                                onclick="document.getElementById('fotoPerfil').click()">
                            Cambiar imagen
                        </button>
                    </div>
                </div>

                <div style="width: 800px;">
                    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-200 dark:border-gray-700 p-8" style="width: 100%;">
                        <div class="space-y-8">
                            <h2 class="text-2xl font-semibold text-gray-800 dark:text-white mb-8">Acerca de ti</h2>

                            <div class="flex items-center justify-between py-6 border-b border-black/80 dark:border-white/30">
                                <label class="text-gray-700 dark:text-gray-300 font-medium text-base flex-shrink-0">Nombre</label>
                                <div class="flex items-center space-x-6">
                                    <span id="nombreDisplay" class="text-gray-800 dark:text-white font-medium text-base">@Model.Nombre</span>
                                    @Html.TextBoxFor(m => m.Nombre, new
                                    {
                                        @class = "bg-transparent text-gray-800 dark:text-white font-medium border-none outline-none text-base hidden",
                                        @placeholder = "Tu nombre",
                                        @id = "nombreInput"
                                    })
                                    <button type="button" class="flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xs flex-shrink-0"
                                            onclick="toggleEdit('nombre')">
                                        <i id="nombreIcon" class="fa-solid fa-pen text-xs"></i>
                                        <span id="nombreText" class="text-xs">Editar</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between py-6 border-b border-black/80 dark:border-white/30">
                                <label class="text-gray-700 dark:text-gray-300 font-medium text-base flex-shrink-0">Nombre de usuario</label>
                                <div class="flex items-center space-x-6">
                                    <span id="apellidoDisplay" class="text-gray-800 dark:text-white font-medium text-base">@Model.Apellido</span>
                                    @Html.TextBoxFor(m => m.Apellido, new
                                    {
                                        @class = "bg-transparent text-gray-800 dark:text-white font-medium border-none outline-none text-base hidden",
                                        @placeholder = "Usuario",
                                        @id = "apellidoInput"
                                    })
                                    <button type="button" class="flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xs flex-shrink-0"
                                            onclick="toggleEdit('apellido')">
                                        <i id="apellidoIcon" class="fa-solid fa-pen text-xs"></i>
                                        <span id="apellidoText" class="text-xs">Editar</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between py-6 border-b border-black/80 dark:border-white/30">
                                <label class="text-gray-700 dark:text-gray-300 font-medium text-base flex-shrink-0">Correo electrónico</label>
                                <div class="flex items-center space-x-6">
                                    <span id="correoDisplay" class="text-gray-800 dark:text-white font-medium text-base">@Model.CorreoElectronico</span>
                                    @Html.TextBoxFor(m => m.CorreoElectronico, new
                                    {
                                        @class = "bg-transparent text-gray-800 dark:text-white font-medium border-none outline-none text-base hidden",
                                        @placeholder = "correo@ejemplo.com",
                                        @id = "correoInput"
                                    })
                                    <button type="button" class="flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xs flex-shrink-0"
                                            onclick="toggleEdit('correo')">
                                        <i id="correoIcon" class="fa-solid fa-pen text-xs"></i>
                                        <span id="correoText" class="text-xs">Editar</span>
                                    </button>
                                </div>
                            </div>

                            <div class="flex items-center justify-between py-6 border-b border-black/80 dark:border-white/30">
                                <label class="text-gray-700 dark:text-gray-300 font-medium text-base flex-shrink-0">Teléfono</label>
                                <div class="flex items-center space-x-6">
                                    <span id="telefonoDisplay" class="text-gray-800 dark:text-white font-medium text-base">@Model.Telefono</span>
                                    @Html.TextBoxFor(m => m.Telefono, new
                                    {
                                        @class = "bg-transparent text-gray-800 dark:text-white font-medium border-none outline-none text-base hidden",
                                        @placeholder = "Teléfono",
                                        @id = "telefonoInput"
                                    })
                                    <button type="button" class="flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xs flex-shrink-0"
                                            onclick="toggleEdit('telefono')">
                                        <i id="telefonoIcon" class="fa-solid fa-pen text-xs"></i>
                                        <span id="telefonoText" class="text-xs">Editar</span>
                                    </button>
                                </div>
                            </div>

                            <div class="pt-4 border-b border-black/80 dark:border-white/30 pb-6">
                                <div class="flex items-center justify-between mb-6">
                                    <label class="block text-gray-700 dark:text-gray-300 font-medium text-base">Biografía</label>
                                    <button type="button" class="flex items-center space-x-2 text-purple-600 dark:text-purple-400 hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-xs"
                                            onclick="toggleEdit('biografia')">
                                        <i id="biografiaIcon" class="fa-solid fa-pen text-xs"></i>
                                        <span id="biografiaText" class="text-xs">Editar</span>
                                    </button>
                                </div>
                                <div id="biografiaDisplay" class="w-full p-4 bg-gray-50 dark:bg-gray-700 rounded-xl text-gray-800 dark:text-white text-base min-h-[120px]">
                                    @(Model.Biografia ?? "Cuéntanos algo sobre ti...")
                                </div>
                                @Html.TextAreaFor(m => m.Biografia, new
                                {
                                    @class = "w-full p-4 border border-gray-300 dark:border-gray-600 rounded-xl bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-white placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-purple-500 focus:border-transparent resize-none text-base hidden",
                                    @rows = "4",
                                    @placeholder = "Cuéntanos algo sobre ti...",
                                    @id = "biografiaInput",
                                    @maxlength = "50"
                                })
                            </div>
                        </div>
                    </div>

                    <div class="pt-8 pb-16 flex justify-center">
                        <button type="submit"
                                class="text-purple-600 dark:text-purple-400 font-medium hover:text-purple-700 dark:hover:text-purple-300 transition-colors text-lg flex items-center space-x-2">
                            <i class="fa-solid fa-save"></i>
                            <span>Guardar Cambios</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function toggleEdit(field) {
        const display = document.getElementById(field + 'Display');
        const input = document.getElementById(field + 'Input');
        const icon = document.getElementById(field + 'Icon');
        const text = document.getElementById(field + 'Text');

        if (input.classList.contains('hidden')) {
            display.classList.add('hidden');
            input.classList.remove('hidden');
            input.focus();

            icon.className = 'fa-solid fa-check text-xs text-green-600';
            text.textContent = 'Guardar';
            text.className = 'text-xs text-green-600';
        } else {
            display.classList.remove('hidden');
            input.classList.add('hidden');

            display.textContent = input.value || (field === 'biografia' ? 'Cuéntanos algo sobre ti...' : '');

            icon.className = 'fa-solid fa-pen text-xs';
            text.textContent = 'Editar';
            text.className = 'text-xs';
        }
    }

    document.getElementById('fotoPerfil').addEventListener('change', function (event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const previewImg = document.getElementById('previewImagen');
                const placeholder = document.getElementById('avatarPlaceholder');

                const container = document.createElement('div');
                container.className = 'relative';

                previewImg.src = e.target.result;
                previewImg.classList.remove('hidden');

                previewImg.className = 'rounded-full object-cover border-4 border-white dark:border-gray-600 shadow-xl brightness-75';
                previewImg.style.width = '320px';
                previewImg.style.height = '320px';
                previewImg.style.minWidth = '320px';
                previewImg.style.minHeight = '320px';

                const overlay = document.createElement('div');
                overlay.className = 'absolute inset-0 rounded-full flex items-center justify-center';
                overlay.innerHTML = '<label for="fotoPerfil" class="cursor-pointer"><i class="fa-solid fa-camera text-4xl text-white drop-shadow-lg"></i></label>';

                const parent = previewImg.parentNode;
                container.appendChild(previewImg);
                container.appendChild(overlay);
                parent.innerHTML = '';
                parent.appendChild(container);

                if (placeholder) {
                    placeholder.style.display = 'none';
                }
            };
            reader.readAsDataURL(file);
        }
    });

    document.getElementById('biografiaInput').addEventListener('input', function () {
        this.style.height = 'auto';
        this.style.height = this.scrollHeight + 'px';
    });
</script>