@model SmartSys.Models.Usuario

@{
    ViewBag.Title = "Login";
}

<div class="min-h-screen flex items-center justify-center bg-gray-50 dark:bg-gray-900 px-4">
    <div class="w-full max-w-md bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 p-8 relative overflow-hidden">
        <!-- Título principal -->
        <div class="mb-6 text-center">
            <h1 class="text-4xl md:text-5xl font-bold text-purple-900 dark:text-purple-400">
                Bienvenido
            </h1>
            <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm md:text-base">
                Introduce tu correo y contraseña para continuar
            </p>
        </div>

        <!-- Separador -->
        <div class="flex items-center my-6">
            <hr class="flex-grow border-gray-300 dark:border-gray-600">
        </div> <br />

        <!-- Manejo de errores -->
        @if (ViewBag.Error != null)
        {
            <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl p-4 mb-6">
                <div class="flex items-center">
                    <i class="fa-solid fa-exclamation-triangle text-red-500 mr-3"></i>
                    <div>
                        <h3 class="text-sm font-semibold text-red-800 dark:text-red-200">Error de autenticación</h3>
                        <p class="text-sm text-red-700 dark:text-red-300 mt-1">@ViewBag.Error</p>
                    </div>
                </div>
            </div>
        }

        @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "space-y-5" }))
        {
            <!-- Email -->
            <div class="space-y-1">
                @Html.LabelFor(m => m.CorreoElectronico, new { @class = "pb-4 block text-sm font-medium text-gray-700 dark:text-gray-200" })
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-envelope text-gray-400 dark:text-gray-500"></i>
                    </div>
                    @Html.TextBoxFor(m => m.CorreoElectronico, new
                    {
                        @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                        @placeholder = "Ingresa tu correo",
                        @type = "email",
                        @autocomplete = "email",
                        @required = "required"
                    })
                </div>
            </div> <br />

            <!-- Contraseña -->
            <div class="space-y-1">
                @Html.Label("Contraseña", new { @class = "pb-4 block text-sm font-medium text-gray-700 dark:text-gray-200" })
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-lock text-gray-400 dark:text-gray-500"></i>
                    </div>
                    @Html.PasswordFor(m => m.Contrasena, new
                    {
                        @class = "w-full pl-10 pr-12 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                        @placeholder = "Ingresa tu contraseña",
                        @id = "password-field",
                        @autocomplete = "current-password",
                        @required = "required"
                    })
                    <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200">
                        <i class="fa-solid fa-eye" id="eye-icon"></i>
                    </button>
                </div>
            </div> <br />

            <!-- Botón iniciar sesión -->
            <button type="submit" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 shadow-lg">
                <div class="flex items-center justify-center">
                    Iniciar Sesión
                </div>
            </button> <br /> <br />

            <!-- Separador -->
            <div class="flex items-center my-6">
                <hr class="flex-grow border-gray-300 dark:border-gray-600">
                <span class="mx-3 text-gray-500 dark:text-gray-400 text-sm md:text-base font-medium">Inicia con</span>
                <hr class="flex-grow border-gray-300 dark:border-gray-600">
            </div>

            <!-- Botón Google -->
            <div id="googleSignInButton" class="flex justify-center mt-4">
                <button type="button"
                        onclick="handleGoogleSignIn()"
                        class="flex items-center justify-center w-16 h-16 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700
                   rounded-xl shadow-md hover:shadow-lg transition transform hover:scale-105">
                    <img src="~/Content/img/google-logo.png" alt="Google Logo" class="w-8 h-8">
                </button>
            </div>

            <!-- Restablecer contraseña -->
            <div class="text-center mt-4">
                <a href="@Url.Action("RestablecerContraseña", "Account")"
                   class="ttext-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300 font-medium transition-colors duration-200e">
                    ¿Has olvidado la contraseña?
                </a>
            </div>
        }
        <div class="text-center mt-4">
            <p class="text-gray-600 dark:text-gray-400">
                ¿Ya tienes una cuenta?
                <a href="@Url.Action("Registro", "Account")" class="text-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300 font-medium transition-colors duration-200">
                    Crea una Cuenta Aqui
                </a>
            </p>
        </div>

    </div>
</div>

<script src="~/Content/js/oauth.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const togglePassword = document.getElementById('toggle-password');
        const passwordField = document.getElementById('password-field');
        const eyeIcon = document.getElementById('eye-icon');

        togglePassword.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);
            eyeIcon.className = type === 'password' ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
        });

        // Animaciones de entrada
        const loginContainer = document.querySelector('.max-w-md');
        loginContainer.style.opacity = '0';
        loginContainer.style.transform = 'translateY(20px)';
        setTimeout(() => {
            loginContainer.style.transition = 'all 0.6s ease-out';
            loginContainer.style.opacity = '1';
            loginContainer.style.transform = 'translateY(0)';
        }, 100);
    });
</script>
