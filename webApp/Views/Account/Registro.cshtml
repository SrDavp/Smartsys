@model SmartSys.Models.Usuario

@{
    ViewBag.Title = "Registro";
}


<div class="container mx-auto mt-8 min-h-screen bg-gray-50  dark:bg-gray-900 py-8 px-4">
    <div class="max-w-2xl mx-auto">
        <!-- Formulario de Registro -->
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-100 dark:border-gray-700 p-8">
            @using (Html.BeginForm("Registro", "Account", FormMethod.Post, new { enctype = "multipart/form-data", @class = "space-y-6" }))
            {
                <div class="mb-6 text-center">
                    <h1 class="text-4xl md:text-5xl font-bold text-purple-900 dark:text-purple-400">
                        Crear una cuenta SmartSys
                    </h1>
                    <p class="text-gray-600 dark:text-gray-300 mt-2 text-sm md:text-base">
                        Crea una cuenta un unite a nuestra plataforma
                    </p>
                </div>
                <!-- Manejo de Errores -->
                if (ViewBag.Error != null)
                {
                    <div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl p-4 mb-6">
                        <div class="flex items-center">
                            <i class="fa-solid fa-exclamation-triangle text-red-500 mr-3"></i>
                            <div>
                                <h3 class="text-sm font-medium text-red-800 dark:text-red-200">Error en el registro</h3>
                                <p class="text-sm text-red-700 dark:text-red-300 mt-1">@ViewBag.Error</p>
                            </div>
                        </div>
                    </div>
                }
                //Separador
                <div class="flex items-center my-6">
                    <hr class="flex-grow border-gray-300 dark:border-gray-600">
                </div>
                <div class="dark:bg-gray-700 rounded-xl p-5">
                    <label class=" text-center block text-lg font-semibold text-gray-700 dark:text-gray-200 mb-3">Foto de Perfil</label>
                    <!-- Foto de Perfil -->
                    <div class="flex justify-center items-center mb-8">
                        <div class="flex items-center space-x-8">
                            <div class="shrink-0">
                                <img id="preview-image"
                                     class="h-32 w-32 md:h-40 md:w-40 object-cover rounded-full border-4 border-purple-200 dark:border-purple-600 bg-gray-100 dark:bg-gray-600"
                                     src="data:image/svg+xml;base64,"
                                     alt="Vista previa">
                            </div>
                            <div class="w-20"></div>
                            <div class="flex-1">
                                <input type="file" name="FotoPerfil" id="foto-perfil" class="hidden" accept="image/*">
                                <button type="button" onclick="document.getElementById('foto-perfil').click()"
                                        class="bg-purple-600 hover:bg-purple-700 text-white px-6 py-3 rounded-xl transition-colors duration-200 text-base md:text-lg font-semibold">
                                    <i class="fa-solid fa-camera mr-3"></i>
                                    Seleccionar Foto
                                </button>
                                <p class="text-sm md:text-base text-gray-600 dark:text-gray-400 mt-3">PNG, JPG hasta 5MB</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información Personal -->
                <div class="bg-white dark:bg-gray-800 rounded-xl p-6 mb-6">



                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Nombre -->
                        <div class="space-y-2">
                            @Html.LabelFor(m => m.Nombre, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-user text-gray-400 dark:text-gray-500"></i>
                                </div>
                                @Html.TextBoxFor(m => m.Nombre, new
                                {
                                    @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                                    @placeholder = "Nombre",
                                    @required = "required"
                                })
                            </div>
                        </div>

                        <!-- Apellido -->
                        <div class="space-y-2">
                            @Html.LabelFor(m => m.Apellido, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-user text-gray-400 dark:text-gray-500"></i>
                                </div>
                                @Html.TextBoxFor(m => m.Apellido, new
                                {
                                    @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                                    @placeholder = "Apellido",
                                    @required = "required"
                                })
                            </div>
                        </div>

                        <!-- Teléfono -->
                        <div class="space-y-2">
                            @Html.LabelFor(m => m.Telefono, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-phone text-gray-400 dark:text-gray-500"></i>
                                </div>
                                @Html.TextBoxFor(m => m.Telefono, new
                                {
                                    @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                                    @placeholder = "Telefono",
                                    @type = "tel"
                                })
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="space-y-2">
                            @Html.LabelFor(m => m.CorreoElectronico, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fa-solid fa-envelope text-gray-400 dark:text-gray-500"></i>
                                </div>
                                @Html.TextBoxFor(m => m.CorreoElectronico, new
                                {
                                    @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                                    @type = "email",
                                    @autocomplete = "Correo Electronico",
                                    @required = "required",
                                    @placeholder = "tu@email.com"
                                })
                            </div>
                        </div>
                    </div>
                    <div class="h-8"></div>
                    <!-- Biografía -->
                    <div class="space-y-2">
                        @Html.LabelFor(m => m.Biografia, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                        <div class="relative">
                            <div class="absolute top-3 left-0 pl-3 flex items-start pointer-events-none">
                                <i class="fa-solid fa-quote-left text-gray-400 dark:text-gray-500"></i>
                            </div>
                            @Html.TextAreaFor(m => m.Biografia, new
                            {
                                @class = "w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500 resize-none",
                                @placeholder = "Biografia(Opcional)",
                                @rows = "3"
                            })
                        </div>
                    </div>
                </div>

                <!-- Seguridad -->
                <div class="bg-gradient-to-r from-purple-50 to-emerald-50 dark:from-gray-700 dark:to-gray-600 rounded-xl p-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white mb-4 flex items-center">
                        <i class="fa-solid fa-shield-halved text-purple-600 mr-2"></i>
                        Seguridad de la Cuenta
                    </h3>

                    <!-- Contraseña -->
                    <div class="space-y-2">
                        @Html.LabelFor(m => m.Contrasena, new { @class = "mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200" })
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-lock text-gray-400 dark:text-gray-500"></i>
                            </div>
                            @Html.PasswordFor(m => m.Contrasena, new
                            {
                                @class = "w-full pl-10 pr-12 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500",
                                @placeholder = "Crea una contraseña segura",
                                @id = "password-field",
                                @required = "required",
                                @minlength = "6"
                            })
                            <button type="button" id="toggle-password" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors duration-200">
                                <i class="fa-solid fa-eye" id="eye-icon"></i>
                            </button>
                        </div>

                        <!-- Indicador de fuerza de contraseña -->
                        <div class="mt-2">
                            <div class="flex items-center space-x-2 text-xs">
                                <span class="text-gray-600 dark:text-gray-400">Seguridad:</span>
                                <div id="password-strength" class="flex space-x-1">
                                    <div class="strength-bar w-6 h-2 bg-gray-200 dark:bg-gray-600 rounded"></div>
                                    <div class="strength-bar w-6 h-2 bg-gray-200 dark:bg-gray-600 rounded"></div>
                                    <div class="strength-bar w-6 h-2 bg-gray-200 dark:bg-gray-600 rounded"></div>
                                    <div class="strength-bar w-6 h-2 bg-gray-200 dark:bg-gray-600 rounded"></div>
                                </div>
                                <span id="strength-text" class="text-gray-500 dark:text-gray-400">Débil</span>
                            </div>
                        </div>
                    </div>

                    <!-- Confirmar Contraseña -->
                    <div class="space-y-2 mt-4">
                        <label class="mb-5 block text-sm font-semibold text-gray-700 dark:text-gray-200">Confirmar Contraseña</label>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                <i class="fa-solid fa-lock text-gray-400 dark:text-gray-500"></i>
                            </div>
                            <input type="password" id="confirm-password" class="w-full pl-10 pr-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent dark:bg-gray-700 dark:text-white transition-all duration-200 placeholder-gray-400 dark:placeholder-gray-500"
                                   placeholder="Confirma contraseña" required>
                        </div>
                    </div>
                </div>

                <!-- Términos y Condiciones -->
                <div class="flex items-start space-x-3">
                    <input type="checkbox" id="terms" class="h-5 w-5 text-purple-600 focus:ring-purple-500 border-gray-300 rounded dark:border-gray-600 dark:bg-gray-700 mt-0.5" required>
                    <label for="terms" class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed">
                        Acepto los
                        <a href="#" class="text-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300 font-medium">Términos y Condiciones</a>
                        y la
                        <a href="#" class="text-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300 font-medium">Política de Privacidad</a>
                        de SmartSys.
                    </label>
                </div>
                <br>
                <!-- Separador -->
                <div class="flex items-center my-6">
                    <hr class="flex-grow border-gray-300 dark:border-gray-600">
                    <span class="mx-3 text-gray-500 dark:text-gray-400 text-sm md:text-base font-medium">Registrate con</span>
                    <hr class="flex-grow border-gray-300 dark:border-gray-600">
                </div>

                <!-- Botón Google -->
                <div id="googleSignInButton" class="flex justify-center mt-4">
                    <button type="button"
                            onclick="handleGoogleSignIn()"
                            class="flex items-center justify-center w-16 h-16 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-700
                   rounded-xl shadow-md hover:shadow-lg transition transform hover:scale-105">
                        <img src="~/Content/img/google-logo.png" alt="Google Logo" class="w-8 h-8">
                    </button>
                </div>

                <!-- Botón de Submit -->
                <button type="submit" id="submit-btn" class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 transform hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 shadow-lg">
                    <div class="flex items-center justify-center">
                        Crear Cuenta
                    </div>
                </button>
                <!-- Link para Login -->
                <div class="text-center">
                    <p class="text-gray-600 dark:text-gray-400">
                        ¿Ya tienes una cuenta?
                        <a href="@Url.Action("Login", "Account")" class="text-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300 font-semibold transition-colors duration-200">
                            Inicia sesión aquí
                        </a>
                    </p>
                </div>
            }

        </div>



    </div>
</div>

<!-- Loading Overlay -->
<div id="loading-overlay" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 flex items-center space-x-4 shadow-2xl">
        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-purple-600"></div>
        <span class="text-gray-700 dark:text-gray-200 font-medium">Creando tu cuenta...</span>
    </div>
</div>


<script src="~/Content/js/oauth.js"></script>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Funcionalidad para mostrar/ocultar contraseña
        const togglePassword = document.getElementById('toggle-password');
        const passwordField = document.getElementById('password-field');
        const eyeIcon = document.getElementById('eye-icon');

        togglePassword.addEventListener('click', function () {
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);

            if (type === 'password') {
                eyeIcon.className = 'fa-solid fa-eye';
            } else {
                eyeIcon.className = 'fa-solid fa-eye-slash';
            }
        });

        // Preview de imagen
        const fotoPerfilInput = document.getElementById('foto-perfil');
        const previewImage = document.getElementById('preview-image');

        fotoPerfilInput.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    previewImage.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Validación de contraseña en tiempo real
        const confirmPasswordField = document.getElementById('confirm-password');
        const strengthBars = document.querySelectorAll('.strength-bar');
        const strengthText = document.getElementById('strength-text');

        function checkPasswordStrength(password) {
            let strength = 0;
            if (password.length >= 6) strength++;
            if (password.match(/[a-z]/) && password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;

            return strength;
        }

        function updatePasswordStrength(strength) {
            const colors = ['bg-red-500', 'bg-orange-500', 'bg-yellow-500', 'bg-green-500'];
            const texts = ['Débil', 'Regular', 'Buena', 'Excelente'];

            strengthBars.forEach((bar, index) => {
                bar.className = 'strength-bar w-6 h-2 rounded transition-colors duration-200';
                if (index < strength) {
                    bar.classList.add(colors[strength - 1]);
                } else {
                    bar.classList.add('bg-gray-200', 'dark:bg-gray-600');
                }
            });

            strengthText.textContent = strength > 0 ? texts[strength - 1] : 'Débil';
            strengthText.className = `text-xs ${strength > 2 ? 'text-green-600' : strength > 1 ? 'text-yellow-600' : 'text-red-600'}`;
        }

        passwordField.addEventListener('input', function () {
            const strength = checkPasswordStrength(this.value);
            updatePasswordStrength(strength);

            if (confirmPasswordField.value) {
                validatePasswordMatch();
            }
        });

        function validatePasswordMatch() {
            if (passwordField.value !== confirmPasswordField.value) {
                showFieldError(confirmPasswordField, 'Las contraseñas no coinciden');
                return false;
            } else {
                removeFieldError(confirmPasswordField);
                return true;
            }
        }

        confirmPasswordField.addEventListener('input', validatePasswordMatch);
        confirmPasswordField.addEventListener('blur', validatePasswordMatch);

        // Validación de email
        const emailField = document.getElementById('CorreoElectronico');

        function validateEmail(email) {
            const re = /^[^\s]+[^\s]+\.[^\s]+$/;
            return re.test(email);
        }

        function showFieldError(field, message) {
            removeFieldError(field);
            const errorDiv = document.createElement('div');
            errorDiv.className = 'field-error text-red-500 text-sm mt-1';
            errorDiv.textContent = message;
            field.parentNode.appendChild(errorDiv);
            field.classList.add('border-red-500');
        }

        function removeFieldError(field) {
            const existingError = field.parentNode.querySelector('.field-error');
            if (existingError) {
                existingError.remove();
            }
            field.classList.remove('border-red-500');
        }

        if (emailField) {
            emailField.addEventListener('blur', function () {
                if (this.value && !validateEmail(this.value)) {
                    showFieldError(this, 'Por favor ingresa un email válido');
                } else {
                    removeFieldError(this);
                }
            });
        }

        // Validación del formulario completo
        const form = document.querySelector('form');
        const submitBtn = document.getElementById('submit-btn');
        const loadingOverlay = document.getElementById('loading-overlay');
        const termsCheckbox = document.getElementById('terms');

        function validateForm() {
            const isEmailValid = validateEmail(emailField.value);
            const isPasswordStrong = checkPasswordStrength(passwordField.value) >= 2;
            const doPasswordsMatch = validatePasswordMatch();
            const areTermsAccepted = termsCheckbox.checked;
            const areRequiredFieldsFilled = passwordField.value && emailField.value &&
                document.getElementById('Nombre').value &&
                document.getElementById('Apellido').value;

            const isFormValid = isEmailValid && isPasswordStrong && doPasswordsMatch && areTermsAccepted && areRequiredFieldsFilled;

            submitBtn.disabled = !isFormValid;
            return isFormValid;
        }

        // Validar formulario en tiempo real
        [emailField, passwordField, confirmPasswordField, termsCheckbox,
            document.getElementById('Nombre'), document.getElementById('Apellido')].forEach(field => {
                if (field) {
                    field.addEventListener('input', validateForm);
                    field.addEventListener('change', validateForm);
                }
            });

        form.addEventListener('submit', function (e) {
            if (!validateForm()) {
                e.preventDefault();
                return;
            }
            loadingOverlay.classList.remove('hidden');
        });

        // Animaciones de entrada
        const formContainer = document.querySelector('.max-w-2xl');
        formContainer.style.opacity = '0';
        formContainer.style.transform = 'translateY(20px)';

        setTimeout(() => {
            formContainer.style.transition = 'all 0.6s ease-out';
            formContainer.style.opacity = '1';
            formContainer.style.transform = 'translateY(0)';
        }, 100);

        // Validar formulario al cargar
        validateForm();
    });

    // Efecto de partículas (heredado del login)
    function createParticle() {
        const particle = document.createElement('div');
        particle.className = 'absolute rounded-full opacity-10 bg-purple-400 dark:bg-purple-600 pointer-events-none';
        particle.style.width = Math.random() * 6 + 2 + 'px';
        particle.style.height = particle.style.width;
        particle.style.left = Math.random() * 100 + '%';
        particle.style.top = '100%';
        particle.style.animation = `float-up ${Math.random() * 3 + 4}s linear`;

        document.body.appendChild(particle);

        particle.addEventListener('animationend', () => {
            particle.remove();
        });
    }

    setInterval(createParticle, 3000);
</script>
