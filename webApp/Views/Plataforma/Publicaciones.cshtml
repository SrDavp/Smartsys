@model List<SmartSys.Models.Publicaciones>
@{
    ViewBag.Title = "Contenido";
    var plataformaId = ViewBag.PlataformaId;
}

<div class="max-w-6xl mx-auto p-4 space-y-6">

    <h2 class="text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-4">
        Contenido de la Plataforma
    </h2>

    <a href="@Url.Action("CrearPublicacion", new { id = plataformaId })"
       class="inline-block mb-6 px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-300">
        + Nueva Publicación
    </a>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var p in Model)
        {
            <div class="bg-white dark:bg-gray-900 rounded-2xl shadow hover:shadow-2xl transition-transform duration-300 p-5 flex flex-col">

                <!-- Encabezado de la publicación -->
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-purple-700 dark:text-purple-300 truncate max-w-[60%]">@p.titulo</h3>
                    <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-100 rounded-full text-xs font-semibold">
                        @p.tipoPublicacion
                    </span>
                </div>

                <!-- Archivo adjunto -->
                @if (p.archivoAdjunto != null)
                {
                    var base64 = Convert.ToBase64String(p.archivoAdjunto);
                    var mimeType = "data:image/png;base64";
                    <div class="mb-2">
                        <img src="data:@mimeType;base64,@base64"
                             class="rounded-lg shadow-sm border border-gray-300 dark:border-gray-700 max-h-32 w-full object-contain"
                             alt="Archivo adjunto" />
                    </div>
                }
                <!-- Fecha de publicación -->
                <p class="text-gray-500 dark:text-gray-400 text-xs mb-3">
                    Publicado el: @(p.fechaPublicacion.HasValue
                        ? p.fechaPublicacion.Value.ToString("dd/MM/yyyy")
                        : "Fecha no disponible")
                </p>

                <!-- Contenido -->
                <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white mb-3 text-sm max-h-28 overflow-y-auto">
                    @Html.Raw(p.contenido)
                </div>

                <!-- Botón ver más -->
                <a href="@Url.Action("VerPublicacion", new { id = p.idPublicacion })"
                   class="mt-auto inline-block px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg text-center font-medium transition-all duration-300">
                    Ver más
                </a>
            </div>
        }
    </div>
</div>
