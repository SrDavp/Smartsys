@model List<SmartSys.Models.Publicaciones>
@{
    ViewBag.Title = "Contenido";
}

<div class="max-w-6xl mx-auto p-4 space-y-4">

    <h2 class="text-2xl md:text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-4">
        Contenido de la Plataforma
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

        @foreach (var p in Model)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md border border-purple-100 dark:border-purple-800 p-4 transition-transform hover:scale-[1.01] duration-200">

                <!-- Encabezado de la publicación -->
                <div class="flex items-center justify-between mb-2">
                    <h3 class="text-lg font-bold text-purple-700 dark:text-purple-300 truncate max-w-[40%]">@p.titulo</h3>
                    <span class="px-2 py-0.5 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-100 rounded-full text-xs font-semibold">
                        @p.tipoPublicacion
                    </span>
                </div>

                <!-- Fecha de publicación -->
                <p class="text-gray-500 dark:text-gray-400 text-xs mb-2">
                    Publicado el: @(p.fechaPublicacion.HasValue
                        ? p.fechaPublicacion.Value.ToString("dd/MM/yyyy")
                        : "Fecha no disponible")
                </p>

                <!-- Contenido -->
                <div class="border border-gray-300 dark:border-gray-700 rounded-lg p-2 bg-gray-50 dark:bg-gray-700 text-gray-900 dark:text-white mb-2 text-sm max-h-24 overflow-hidden">
                    @Html.Raw(p.contenido)
                </div>

                <!-- Archivo adjunto más pequeño -->
                @if (p.archivoAdjunto != null)
                {
                    var base64 = Convert.ToBase64String(p.archivoAdjunto);
                    var mimeType = "data:image/png;base64";
                    <div class="mb-2">
                        <img src="data:@mimeType;base64,@base64" class="rounded-lg shadow border border-gray-300 dark:border-gray-700 max-h-24 max-w-[150px] object-contain" alt="Archivo adjunto" />
                    </div>
                }
            </div>
        }
    </div>
</div>
