@model List<SmartSys.Models.Publicaciones>
@{
    ViewBag.Title = "Contenido";
    var plataformaId = ViewBag.PlataformaId;
    var totalPublicaciones = Model.Count;
    var tipos = Model.Select(p => p.tipoPublicacion).Distinct().ToList();
}

<div class="max-w-6xl mx-auto p-4 space-y-6">

    <h2 class="text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-4">
        Contenido de la Plataforma
    </h2>

    <a href="@Url.Action("CrearPublicacion", new { id = plataformaId })"
       class="inline-block mb-6 px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-300">
        + Nueva Publicación
    </a>

    <div class="bg-purple-50 dark:bg-gray-800 p-4 rounded-xl shadow flex-1 min-w-[180px]">
        <p class="text-gray-700 dark:text-gray-300">Números de Publicaciones</p>
        <p class="text-2xl font-bold text-purple-700 dark:text-purple-300">@totalPublicaciones</p>
    </div>

    <!-- Buscador y filtros -->
    <div class="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <input type="text" id="buscarPublicacion" placeholder="Buscar por título o contenido..."
               class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition" />

        <select id="filtroTipo" class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition">
            <option value="">Todos los tipos</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo">@tipo</option>
            }
        </select>

        <input type="date" id="filtroFecha"
               class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition" />
    </div>

    <div id="publicacionesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var p in Model)
        {
            var autores = ViewBag.Autores as Dictionary<long, string>;
            var nombreAutor = autores.ContainsKey(p.idPublicacion) ? autores[p.idPublicacion] : "Desconocido";

            <div class="publicacion bg-white dark:bg-gray-900 rounded-2xl shadow hover:shadow-2xl transition-transform duration-300 p-5 flex flex-col"
                 data-tipo="@p.tipoPublicacion"
                 data-fecha="@(p.fechaPublicacion.HasValue ? p.fechaPublicacion.Value.ToString("yyyy-MM-dd") : "")">
                <div class="flex items-center justify-between mb-3">
                    <h3 class="text-lg font-bold text-purple-700 dark:text-purple-300 truncate max-w-[60%] titulo">@p.titulo</h3>
                    <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-100 rounded-full text-xs font-semibold">
                        @p.tipoPublicacion
                    </span>
                </div>

                @if (p.archivoAdjunto != null)
                {
                    var base64 = Convert.ToBase64String(p.archivoAdjunto);
                    var mimeType = "data:image/png;base64";
                    <div class="mb-2">
                        <img src="data:@mimeType;base64,@base64"
                             class="rounded-lg shadow-sm border border-gray-300 dark:border-gray-700 max-h-32 w-full object-contain"
                             alt="Archivo adjunto" />
                    </div>
                }

                <p class="text-gray-500 dark:text-gray-400 text-xs mb-3">
                    Publicado por: @nombreAutor <br />
                    Fecha publicación: @(p.fechaPublicacion.HasValue ? p.fechaPublicacion.Value.ToString("dd/MM/yyyy") : "No disponible") <br />

                    @if (p.tipoPublicacion == "Tarea" && p.fechaEntrega != null)
                    {
                        <span class="text-purple-700 dark:text-purple-700 font-semibold">
                            Fecha entrega: @Convert.ToDateTime(p.fechaEntrega).ToString("dd/MM/yyyy")
                        </span>
                    }
                </p>


                <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3 bg-gray-50 dark:bg-gray-800 text-gray-900 dark:text-white mb-3 text-sm max-h-28 overflow-y-auto contenido">
                    @Html.Raw(p.contenido)
                </div>

                <a href="@Url.Action("VerPublicacion", new { id = p.idPublicacion })"
                   class="mt-auto inline-block px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg text-center font-medium transition-all duration-300">
                    Ver más
                </a>
                @if (p.tipoPublicacion == "Tarea" && p.fechaEntrega != null)
                {
                    <a href="@Url.Action("VerPublicacion", new { id = p.idPublicacion })" style="margin-top: 2%;"
                       class="inline-block px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg text-center font-medium transition-all duration-300">
                        Entregar tarea
                    </a>
                }
            </div>
        }
    </div>
</div>

<script>
    const input = document.getElementById('buscarPublicacion');
    const filtroTipo = document.getElementById('filtroTipo');
    const filtroFecha = document.getElementById('filtroFecha');
    const publicaciones = document.querySelectorAll('.publicacion');

    function filtrarPublicaciones() {
        const texto = input.value.toLowerCase();
        const tipo = filtroTipo.value;
        const fecha = filtroFecha.value;

        publicaciones.forEach(pub => {
            const titulo = pub.querySelector('.titulo').innerText.toLowerCase();
            const contenido = pub.querySelector('.contenido').innerText.toLowerCase();
            const tipoPub = pub.dataset.tipo;
            const fechaPub = pub.dataset.fecha; // "yyyy-MM-dd" o ""

            const coincideTexto = titulo.includes(texto) || contenido.includes(texto);
            const coincideTipo = tipo === "" || tipoPub === tipo;
            const coincideFecha = fecha === "" || fechaPub === fecha;

            pub.style.display = (coincideTexto && coincideTipo && coincideFecha) ? 'flex' : 'none';
        });
    }

    input.addEventListener('input', filtrarPublicaciones);
    filtroTipo.addEventListener('change', filtrarPublicaciones);
    filtroFecha.addEventListener('change', filtrarPublicaciones);
</script>