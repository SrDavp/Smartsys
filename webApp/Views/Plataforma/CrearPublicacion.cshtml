@model SmartSys.Models.Publicaciones
@{
    ViewBag.Title = "Nueva Publicación";
}

<h2 class="text-xl font-bold mb-4">Crear Publicación</h2>

@using (Html.BeginForm("CrearPublicacion", "Plataforma", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <input type="hidden" name="plataformaId" value="@ViewBag.PlataformaId" />
    <div class="form-group">
        @Html.LabelFor(m => m.titulo)
        @Html.TextBoxFor(m => m.titulo, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.contenido)
        @Html.TextAreaFor(m => m.contenido, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.tipoPublicacion)
        @Html.DropDownListFor(m => m.tipoPublicacion, new SelectList(new[] {
            "Publicacion", "Tarea", "Anuncio"
        }), "Selecciona un tipo", new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Archivo Adjunto</label>
        <input type="file" name="archivo" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Crear</button>
}
