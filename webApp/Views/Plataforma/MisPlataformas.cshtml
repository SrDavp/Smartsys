@model List<SmartSys.Models.Plataforma>

@{
    var adminIds = ViewBag.PlataformasAdmin as List<long>;

}

<h2 class="text-2xl font-bold mb-4">Mis Plataformas</h2>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    @foreach (var p in Model)
    {
        <div class="p-4 bg-white rounded shadow">
            <h3 class="text-lg font-bold">@p.nombrePlataforma</h3>
            <p> Descripcion @p.descripcionPlataforma</p>
            <p class="text-sm text-gray-500">Código: @p.codigoPlataforma</p>
            <p class="text-sm">Privacidad: @p.privacidadPlataforma</p>

            <a href="@Url.Action("Detalles", "Plataforma", new { id = p.idPlataforma })" class="text-blue-500 hover:underline">Ver más</a>
            <br />
            @if (adminIds != null && adminIds.Contains(p.idPlataforma))
            {
                <a href="@Url.Action("PanelAdmin", "Plataforma", new { id = p.idPlataforma })" class="text-green-500 hover:underline">Panel Admin</a>
            }
        </div>
    }
</div>
