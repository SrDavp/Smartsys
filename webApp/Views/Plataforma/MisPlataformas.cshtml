@model List<SmartSys.Models.Plataforma>
@{
    var adminIds = ViewBag.PlataformasAdmin as List<long>;
    var totalAdmin = adminIds != null ? adminIds.Count : 0;
    var totalUnido = Model != null ? Model.Count - totalAdmin : 0;
}

<!-- TÍTULO Y ESTADÍSTICAS -->
<div class="max-w-6xl mx-auto py-8 px-4">
    <h2 class="text-3xl font-extrabold text-purple-800 dark:text-white mb-4">Mis Plataformas</h2>

    <!-- Contadores -->
    <div class="flex flex-wrap gap-4 mb-6">
        <div class="bg-purple-50 dark:bg-gray-800 p-4 rounded-xl shadow flex-1 min-w-[180px]">
            <p class="text-gray-700 dark:text-gray-300">Administrando de Plataformas: </p>
            <p class="text-2xl font-bold text-purple-700 dark:text-purple-300">@totalAdmin</p>
        </div>
        <div class="bg-purple-50 dark:bg-gray-800 p-4 rounded-xl shadow flex-1 min-w-[180px]">
            <p class="text-gray-700 dark:text-gray-300">Miembro de Plataformas</p>
            <p class="text-2xl font-bold text-purple-700 dark:text-purple-300">@totalUnido</p>
        </div>
    </div>

    <!-- BUSCADOR -->
    <div class="flex mb-8 max-w-md gap-2">
        <input type="text" id="buscarPlataforma" placeholder="Buscar plataformas..."
               class="flex-1 p-3 rounded-lg border border-gray-300 dark:border-gray-700 dark:bg-gray-800 dark:text-white focus:ring-2 focus:ring-purple-500 focus:outline-none transition-colors duration-300"
               onkeyup="filtrarPlataformas()" />
        <button type="submit"
                class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-lg font-semibold transition-transform duration-300 shadow hover:shadow-lg transform hover:-translate-y-0.5">
            <i class="fa-solid fa-search"></i>
        </button>
    </div>

    <!-- MENSAJE DE NO RESULTADOS -->
    @if (Model == null || !Model.Any())
    {
        <section class="flex items-center justify-center h-96 w-full bg-gray-100 dark:bg-gray-800 transition-colors duration-300 rounded-lg shadow-inner">
            <div class="text-center px-4 py-8">
                <div class="mb-10 text-purple-500 dark:text-purple-400 font-bold animate-pulse" style="font-size: 8rem; line-height: 1;">:(</div>
                <h3 class="text-2xl font-semibold mb-2 text-purple-800 dark:text-purple-200">No tienes plataformas activas</h3>
                <p class="text-base text-purple-600 dark:text-purple-300 mb-6">¡Comencemos a crear una!</p>
                <a href="@Url.Action("Crear", "Plataforma")"
                   class="inline-block px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg hover:scale-105 transition-transform duration-300">
                    Crear Plataforma
                </a>
            </div>
        </section>
    }
    else
    {
        <!-- TARJETAS DE PLATAFORMAS -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mt-6">
    @foreach (var p in Model)
    {
        if (p.estadoPlataforma == "Inactivo")
        {
            <div class="max-w-sm bg-white dark:bg-gray-900 rounded-2xl shadow-lg overflow-hidden border border-red-300 dark:border-red-700">
                <!-- Imagen/Icono de advertencia -->
                <div style="padding-top:25%; padding-bottom:25%" class="bg-red-900 dark:bg-red-900 flex items-center justify-center h-40">
                    <i class="fa-solid fa-triangle-exclamation text-red-600 dark:text-red-300 text-6xl"></i>
                </div>
                <hr />

                <!-- Contenido -->
                <div class="p-6 text-center">
                    <h3 class="text-xl font-extrabold text-red-700 dark:text-red-300 mb-2">
                        Plataforma "@p.nombrePlataforma" Inactiva
                    </h3>
                    <p class="text-red-600 dark:text-red-400 mb-4">
                        Comuníquese con el <span class="font-semibold">Administrador</span>
                        para activarla de nuevo al correo <br>
                        <span class="hover:text-red-800 dark:hover:text-red-200">
                            smartsyscj@gmail.com
                        </span>
                    </p>

                    <!-- Botones -->
                    <div class="flex flex-wrap gap-3 justify-center">
                        <a href="https://workspace.google.com/intl/es-419/gmail/" class="px-4 py-2 bg-gray-200 dark:bg-gray-700 text-gray-800 dark:text-gray-200 rounded-xl shadow hover:bg-gray-300 dark:hover:bg-gray-600 transition">
                             Contactar Soporte
                        </a>
                    </div>
                </div>
            </div>

            continue; // Salta el resto del loop para no mostrar la tarjeta normal
        }

        <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-2xl hover:scale-105 transition-all duration-300 overflow-hidden">
            <!-- Fondo de la tarjeta -->
            <div class="relative w-full h-40 shadow-md overflow-hidden">
                @if (p.fondoPlataforma != null)
                {
                    var base64Fondo = "data:image/png;base64," + Convert.ToBase64String(p.fondoPlataforma);
                    <img src="@base64Fondo" alt="Fondo" class="w-full h-40 object-cover" />
                }
                else
                {
                    <div class="w-full h-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center text-gray-500">No hay imagen de fondo</div>
                }

                <!-- Ícono sobre el fondo -->
                @if (p.iconoPlataforma != null)
                {
                    var base64Icon = "data:image/png;base64," + Convert.ToBase64String(p.iconoPlataforma);
                    <img src="@base64Icon" alt="Ícono"
                         class="absolute bottom-2 left-2 w-20 h-20 rounded-full border-4 border-white dark:border-gray-800 shadow-lg" />
                }
            </div>

            <!-- Contenido de la tarjeta -->
            <div class="p-6 dark:border-purple-100 dark:border">
                <h3 class="text-2xl font-bold text-purple-700 dark:text-purple-300 mb-2">@p.nombrePlataforma</h3>
                <p class="text-gray-700 dark:text-gray-300 mb-3 line-clamp-3">@p.descripcionPlataforma</p>

                <div class="mt-4 flex flex-wrap gap-3">
                    <a href="@Url.Action("Detalles", "Plataforma", new { id = p.idPlataforma })"
                       class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300 font-medium">
                        Ver más
                    </a>
                    <a href="@Url.Action("Publicaciones", "Plataforma", new { id = p.idPlataforma })"
                       class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300 font-medium">
                        Publicaciones
                    </a>
                    <a href="@Url.Action("VerMiembros", "Plataforma", new { id = p.idPlataforma })"
                       class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300 font-medium">
                        Ver Miembros
                    </a>

                    @if (adminIds != null && adminIds.Contains(p.idPlataforma))
                    {
                        <a href="@Url.Action("PanelAdmin", "Plataforma", new { id = p.idPlataforma })"
                           class="px-5 py-2 rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300 font-medium dark:text-white dark:bg-gray-700">
                            Panel Admin
                        </a>
                    }
                </div>
            </div>
        </div>
    }

</div>
    }
</div>

<script>
    function filtrarPlataformas() {
        var input = document.getElementById("buscarPlataforma").value.toLowerCase();
        var tarjetas = document.querySelectorAll(".grid > div");

        tarjetas.forEach(function (tarjeta) {
            var nombre = tarjeta.querySelector("h3").textContent.toLowerCase();
            tarjeta.style.display = nombre.includes(input) ? "" : "none";
        });
    }
</script>
