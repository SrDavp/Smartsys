@model List<SmartSys.Models.Plataforma>
@{
    var adminIds = ViewBag.PlataformasAdmin as List<long>;
}

<!-- TÍTULO -->
<div class="text-center py-8 mb-8">
    <h2 class="text-3xl font-bold text-purple-700 dark:text-purple-400">Mis Plataformas</h2>
</div>

<!-- MENSAJE DE NO RESULTADOS -->
<section class="flex items-center justify-center h-96 w-full bg-purple-50 dark:bg-purple-950 transition-colors duration-300 rounded-lg shadow-inner">
    <div class="text-center px-4 py-8">
        <div class="mb-10 text-purple-500 dark:text-purple-400 font-bold" style="font-size: 8rem; line-height: 1;">:(</div>
        <h3 class="text-2xl font-semibold mb-2 text-purple-800 dark:text-purple-200">No tienes plataformas activas</h3>
        <p class="text-base text-purple-600 dark:text-purple-300">¡Comencemos a crear una!</p>
        <a href="@Url.Action("Crear", "Plataforma")"
           class="mt-6 inline-block px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg hover:scale-105 transition-transform duration-300">
            Crear Plataforma
        </a>
    </div>
</section>

<!-- TARJETAS DE PLATAFORMAS -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
    @foreach (var p in Model)
    {
        <div class="p-6  dark:bg-purple-950 rounded-xl shadow-lg border border-purple-100 dark:border-purple-800 hover:shadow-xl hover:scale-[1.02] transition-all duration-300">
            <h3 class="text-xl font-bold text-purple-700 dark:text-purple-300">@p.nombrePlataforma</h3>
            <p class="text-purple-600 dark:text-purple-200 mt-1">@p.descripcionPlataforma</p>
            <p class="text-sm text-purple-500 dark:text-purple-400 mt-2">Código: @p.codigoPlataforma</p>
            <p class="text-sm text-purple-700 dark:text-purple-300">Privacidad: @p.privacidadPlataforma</p>

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="@Url.Action("Detalles", "Plataforma", new { id = p.idPlataforma })"
                   class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300">
                    Ver más
                </a>
                @if (adminIds != null && adminIds.Contains(p.idPlataforma))
                {
                    <a href="@Url.Action("PanelAdmin", "Plataforma", new { id = p.idPlataforma })"
                       class="px-4 py-2 bg-purple-800 hover:bg-purple-900 text-purple-900 dark:bg-purple-900 dark:hover:bg-purple-950 rounded-lg shadow hover:shadow-lg hover:scale-105 transition-transform duration-300 dark:text-purple-200">
                        Panel Admin
                    </a>
                }
            </div>
        </div>
    }
</div>
