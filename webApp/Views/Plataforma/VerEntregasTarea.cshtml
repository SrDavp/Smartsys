@model IEnumerable<SmartSys.Models.EntregaTareaViewModel>
@{
    ViewBag.Title = "Entregas de Tarea";
}

<div class="max-w-4xl mx-auto p-6">
    <h2 class="text-2xl font-bold text-purple-700 dark:text-purple-300 mb-6">
        Entregas de: @ViewBag.Publicacion
    </h2>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-md">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Usuario</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Archivo</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Fecha de Entrega</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var e in Model)
                {
                    <tr class="hover:bg-purple-50 dark:hover:bg-purple-950 transition-colors duration-300">
                        <td class="px-6 py-4 text-gray-900 dark:text-white">@e.NombreUsuario</td>
                        <td class="px-6 py-4">
                            @if (e.EntregaTarea != null)
                            {
                                // Convertimos a Base64 y asumimos que es imagen (puedes ajustar mimeType si necesitas)
                                var base64 = Convert.ToBase64String(e.EntregaTarea);
                                var mimeType = "image/png"; // o "image/jpeg", depende de tu archivo
                                <img src="data:@mimeType;base64,@base64" alt="Tarea de @e.NombreUsuario" class="max-w-[100px] max-h-[100px] rounded shadow" />
                            }
                            else
                            {
                                <span class="text-gray-500 dark:text-gray-400">Sin entregar</span>
                            }
                        </td>

                        <td class="px-6 py-4 text-gray-700 dark:text-gray-300">
                            @(e.FechaEntregaUsuario != null ? e.FechaEntregaUsuario.Value.ToString("dd/MM/yyyy HH:mm") : "-")
                        </td>
                        <td class="px-6 py-4 text-gray-700 dark:text-gray-300">@e.EstadoEntrega</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
