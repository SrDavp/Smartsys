@model List<SmartSys.Models.Publicaciones>
@{
    ViewBag.Title = "Contenido";
    var plataformaId = ViewBag.PlataformaId;
    var tipos = Model.Select(p => p.tipoPublicacion).Distinct().ToList();
}

<div class="max-w-6xl mx-auto p-6">
    <h2 class="text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-6">Contenido de la Plataforma</h2>

    <a href="@Url.Action("CrearPublicacion", new { id = plataformaId })"
       class="inline-block mb-6 px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-all duration-300">
        + Nueva Publicación
    </a>

    <!-- Buscador y filtros -->
    <div class="mb-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        <input type="text" id="buscarPublicacion" placeholder="Buscar por título..."
               class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition" />

        <select id="filtroTipo"
                class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition">
            <option value="">Todos los tipos</option>
            @foreach (var tipo in tipos)
            {
                <option value="@tipo">@tipo</option>
            }
        </select>

        <input type="date" id="filtroFecha"
               class="w-full p-3 rounded-lg border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow-sm focus:outline-none focus:ring-2 focus:ring-purple-600 transition" />
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-md">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Título</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Tipo</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Fecha Publicación</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Fecha Entrega</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Archivo</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Acciones</th>
                </tr>
            </thead>
            <tbody id="publicacionesTable" class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var p in Model)
                {
                    <tr class="hover:bg-purple-50 dark:hover:bg-purple-950 transition-colors duration-300"
                        data-titulo="@p.titulo.ToLower()"
                        data-tipo="@p.tipoPublicacion"
                        data-fecha="@(p.fechaPublicacion?.ToString("yyyy-MM-dd") ?? "")">
                        <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">@p.titulo</td>
                        <td class="px-4 py-4 text-gray-700 dark:text-gray-300">@p.tipoPublicacion</td>
                        <td class="px-4 py-4 text-gray-700 dark:text-gray-300">
                            @(Convert.ToDateTime(p.fechaPublicacion).ToString("dd/MM/yyyy"))
                        </td>
                        <td class="px-6 py-4 text-gray-700 dark:text-gray-300">
                            @if (p.tipoPublicacion == "Tarea" && p.fechaEntrega != null)
                            {
                                @Convert.ToDateTime(p.fechaEntrega).ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-gray-500 dark:text-gray-400">-</span>
                            }
                        </td>
                        <td class="px-4 py-4">
                            @if (p.archivoAdjunto != null)
                            {
                                var base64 = Convert.ToBase64String(p.archivoAdjunto);
                                var mimeType = "data:image/png;base64";
                                <img src="data:@mimeType;base64,@base64" alt="Adjunto" class="max-w-[100px] max-h-[100px] rounded shadow" />
                            }
                            else
                            {
                                <span class="text-gray-500 dark:text-gray-400">Sin archivo</span>
                            }
                        </td>
                        <td class="px-6 py-4 flex gap-2">
                            <a href="@Url.Action("VerPublicacion", new { id = p.idPublicacion })" class="px-3 py-1 rounded-lg font-medium bg-purple-600 text-white">Ver</a>
                            <a href="@Url.Action("EditarPublicacion", new { id = p.idPublicacion })" class="px-3 py-1 rounded-lg font-medium bg-purple-600 text-white">Editar</a>
                            @if (p.tipoPublicacion == "Tarea")
                            {
                                <a href="@Url.Action("VerEntregasTarea", new { idPublicacion = p.idPublicacion })" class="px-3 py-1 rounded-lg font-medium bg-purple-600 text-white">Tarea</a>
                            }
                            <a href="@Url.Action("EliminarPublicacion", new { id = p.idPublicacion, idPlataforma = plataformaId })" class="px-3 py-1 rounded-lg font-medium bg-red-600 text-white">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    const input = document.getElementById('buscarPublicacion');
    const filtroTipo = document.getElementById('filtroTipo');
    const filtroFecha = document.getElementById('filtroFecha');
    const filas = document.querySelectorAll('#publicacionesTable tr');

    function filtrarTabla() {
        const texto = input.value.toLowerCase();
        const tipo = filtroTipo.value;
        const fecha = filtroFecha.value;

        filas.forEach(fila => {
            const titulo = fila.dataset.titulo;
            const tipoPub = fila.dataset.tipo;
            const fechaPub = fila.dataset.fecha;

            const coincideTexto = titulo.includes(texto);
            const coincideTipo = tipo === "" || tipoPub === tipo;
            const coincideFecha = fecha === "" || fechaPub === fecha;

            fila.style.display = (coincideTexto && coincideTipo && coincideFecha) ? '' : 'none';
        });
    }

    input.addEventListener('input', filtrarTabla);
    filtroTipo.addEventListener('change', filtrarTabla);
    filtroFecha.addEventListener('change', filtrarTabla);
</script>
