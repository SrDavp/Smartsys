@model List<SmartSys.Models.MiembroViewModel>

@{
    ViewBag.Title = "Gestión de Miembros";
    var plataformaId = ViewBag.PlataformaId;
}

<div class="max-w-5xl mx-auto p-6">
    <h2 class="text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-6">Miembros de la Plataforma</h2>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white dark:bg-gray-800 rounded-xl shadow-lg border border-purple-100 dark:border-purple-800">
            <thead class="bg-purple-100 dark:bg-purple-900 text-purple-900 dark:text-purple-100">
                <tr>
                    <th class="text-left px-6 py-3 uppercase font-semibold text-sm">Nombre</th>
                    <th class="text-left px-6 py-3 uppercase font-semibold text-sm">Correo</th>
                    <th class="text-left px-6 py-3 uppercase font-semibold text-sm">Rol</th>
                    <th class="text-left px-6 py-3 uppercase font-semibold text-sm">Acciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-purple-50 dark:hover:bg-purple-950 transition-colors duration-300">
                        <td class="px-6 py-4">@item.Usuario.Nombre @item.Usuario.Apellido</td>
                        <td class="px-6 py-4">@item.Usuario.CorreoElectronico</td>
                        <td class="px-6 py-4">
                            <span class="px-2 py-1 rounded-lg font-medium @(item.Relacion.rolUsuarioPlataforma == "Admin" ? "bg-purple-600 text-white" : "bg-purple-100 text-purple-700 dark:bg-purple-800 dark:text-purple-200")">
                                @item.Relacion.rolUsuarioPlataforma
                            </span>
                        </td>
                        <td class="px-6 py-4 flex gap-2">
                            @if (item.Relacion.rolUsuarioPlataforma != "Admin")
                            {
                                <a href="@Url.Action("CambiarRol", "Plataforma", new { idUsuario = item.Usuario.IdUsuario, idPlataforma = plataformaId })"
                                   class="px-3 py-1 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md hover:shadow-lg transition-all duration-300 text-sm">
                                    Hacer Admin
                                </a>
                                <a href="@Url.Action("Expulsar", "Plataforma", new { idUsuario = item.Usuario.IdUsuario, idPlataforma = plataformaId })"
                                   class="px-3 py-1 bg-red-500 hover:bg-red-600 text-white rounded-lg shadow-md hover:shadow-lg transition-all duration-300 text-sm">
                                    Expulsar
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
