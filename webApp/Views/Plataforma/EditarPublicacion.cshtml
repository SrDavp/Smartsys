@model SmartSys.Models.Publicaciones
@{
    ViewBag.Title = "Editar Publicación";
}

<h2 class="text-xl font-bold mb-4">Editar Publicación</h2>

@using (Html.BeginForm("EditarPublicacion", "Plataforma", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(m => m.idPublicacion)

    <div class="form-group">
        @Html.LabelFor(m => m.titulo)
        @Html.TextBoxFor(m => m.titulo, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.contenido)
        @Html.TextAreaFor(m => m.contenido, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.tipoPublicacion)
        @Html.DropDownListFor(m => m.tipoPublicacion, new SelectList(new[] {
            "Publicacion", "Tarea", "Anuncio"
        }, Model.tipoPublicacion), new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.fechaLimite)
        @Html.TextBoxFor(m => m.fechaLimite, "{0:yyyy-MM-dd}", new { type = "date", @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Archivo Nuevo (opcional)</label>
        <input type="file" name="archivo" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
}
