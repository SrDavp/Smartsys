@model List<SmartSys.Models.Plataforma>
@{
    ViewBag.Title = "Explorar Plataformas";
}

<!-- TÍTULO -->
<div class="text-center py-8 mb-4">
    <h2 class="text-4xl font-extrabold text-purple-900 dark:text-purple-100 tracking-tight">Explorar Plataformas</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 mt-2">
        @if (Model != null)
        {
            @($"{Model.Count} plataforma(s) disponibles")
        }
        else
        {
            @("0 plataformas disponibles")
        }
    </p>
</div>
<!-- FORMULARIO DE BÚSQUEDA -->
<div class="flex justify-center mb-8">
    <form method="get" action="@Url.Action("Explorar", "Plataforma")" class="w-full max-w-md">
        <div class="flex flex-col sm:flex-row gap-2">
            <input type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar plataformas..."
                   class="border border-gray-300 dark:border-gray-600 rounded-lg px-4 py-3 flex-1 bg-white dark:bg-gray-800 text-gray-900 dark:text-white placeholder-gray-500 dark:placeholder-gray-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors duration-300" />
            <button type="submit"
                    class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-lg font-semibold transition-all duration-300 whitespace-nowrap shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                <i class="fa-solid fa-search"></i>
            </button>
        </div>
    </form>
</div>



@if (TempData["Error"] != null)
{
    <div class="flex items-center justify-center mb-6">
        <div class="w-full max-w-lg bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl p-4 flex items-center gap-3">
            <i class="fa-solid fa-exclamation-triangle text-red-500"></i>
            <div>
                <h3 class="text-sm font-semibold text-red-800 dark:text-red-200">Plataforma llena</h3>
                <p class="text-sm text-red-700 dark:text-red-300 mt-1">@TempData["Error"]</p>
            </div>
        </div>
    </div>
}

@if (Model == null || !Model.Any())
{
    <section class="flex items-center justify-center h-96 w-full bg-gray-100 dark:bg-gray-800 transition-colors duration-300 rounded-lg">
        <div class="text-center px-4 py-8">
            <div class="mb-10 text-purple-500 dark:text-purple-400 font-bold animate-pulse" style="font-size: 8rem; line-height: 1;">:(</div>
            <h3 class="text-2xl font-semibold mb-2 text-purple-800 dark:text-purple-100">No se han encontrado plataformas</h3>
            <p class="text-base text-purple-600 dark:text-purple-300">Revisa que lo hayas escrito correctamente</p>
        </div>
    </section>
}
else
{
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 px-4">
    @foreach (var p in Model)
    {
        if (p.estadoPlataforma == "Inactivo")
        {
            continue; // No mostrar esta plataforma
        }

        <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-lg hover:shadow-2xl transition-transform transform hover:-translate-y-1 overflow-hidden">
            <!-- Fondo con overlay -->
            <div class="relative w-full h-40">
                @if (p.fondoPlataforma != null)
                {
                    var base64Fondo = "data:image/png;base64," + Convert.ToBase64String(p.fondoPlataforma);
                    <img src="@base64Fondo" alt="Fondo" class="w-full h-full object-cover" style="filter: brightness(0.8);" />
                }
                else
                {
                    <div style="width:100%;height:100%;background-color:#e5e7eb;display:flex;align-items:center;justify-content:center;color:#6b7280;">
                        Sin fondo
                    </div>
                }

                <!-- Ícono superpuesto -->
                @if (p.iconoPlataforma != null)
                {
                    var base64Icon = "data:image/png;base64," + Convert.ToBase64String(p.iconoPlataforma);
                    <img src="@base64Icon" alt="Ícono"
                         style="position:absolute;bottom:-1.5rem;left:1rem;width:4rem;height:4rem;border-radius:50%;border:3px solid white;box-shadow:0 4px 8px rgba(0,0,0,0.3);" />
                }
            </div>

            <!-- Contenido de la tarjeta -->
            <div class="p-6 pt-10">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">@p.nombrePlataforma</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4 line-clamp-3">@p.descripcionPlataforma</p>

                <div class="bg-white/80 dark:bg-purple-950/80 rounded-xl p-4 shadow-inner backdrop-blur-sm">
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-sm text-gray-500 dark:text-gray-400">Privacidad:</span>
                        <span class="text-sm font-medium px-2 py-1 rounded-lg @(p.privacidadPlataforma == "Público" ? "text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900" : "text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900")">
                            @p.privacidadPlataforma
                        </span>
                    </div>

                    @if (p.privacidadPlataforma == "Privado")
                    {
                        <a href="@Url.Action("UnirsePrivado", "Plataforma", new { id = p.idPlataforma })"
                           class="w-full bg-purple-600 hover:bg-purple-700 dark:bg-purple-700 dark:hover:bg-purple-800 text-white text-center py-2 rounded-lg font-semibold transition-all duration-300 shadow-md mb-2 inline-block">
                            <i class="fa-solid fa-key mr-2"></i> Unirse con código
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("UnirsePublico", "Plataforma", new { id = p.idPlataforma })"
                           class="w-full bg-purple-600 hover:bg-purple-700 dark:bg-purple-700 dark:hover:bg-purple-800 text-white text-center py-2 rounded-lg font-semibold transition-all duration-300 shadow-md mb-2 inline-block">
                            <i class="fa-solid fa-users mr-2"></i> Unirse
                        </a>
                    }
                <a href="@Url.Action("VerMiembros", "Plataforma", new { id = p.idPlataforma })"
                   class="w-full bg-purple-600 hover:bg-purple-700 dark:bg-purple-700 dark:hover:bg-purple-800 text-white text-center py-2 rounded-lg font-semibold transition-all duration-300 shadow-md mb-2 inline-block">
                    <i class="fa-solid fa-users mr-2"></i> Ver Miembros
                </a>
                </div>
            </div>
        </div>
    }

</div>
}
<br />
<br />