@model List<SmartSys.Models.Plataforma>
@{
    ViewBag.Title = "Explorar Plataformas";
}

<!-- TÍTULO -->
<div class="text-center py-8 mb-8">
    <h2 class="text-4xl font-extrabold text-purple-900 dark:text-purple-100 tracking-tight">
        Explorar Plataformas
    </h2>
</div>

<!-- FORMULARIO DE BÚSQUEDA -->
<div class="flex justify-center mb-8">
    <form method="get" action="@Url.Action("Explorar", "Plataforma")" class="w-full max-w-md">
        <div class="flex flex-col sm:flex-row gap-2">
            <input type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar plataformas..."
                   class="border border-purple-300 dark:border-purple-600 rounded-lg px-4 py-3 flex-1 bg-white/80 dark:bg-purple-950/80 text-purple-900 dark:text-purple-100 placeholder-purple-400 focus:ring-4 focus:ring-purple-300 focus:border-purple-500 transition-all duration-300 backdrop-blur-sm shadow-sm" />
            <button type="submit"
                    class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-lg font-semibold transition-all duration-300 whitespace-nowrap shadow-md hover:shadow-lg transform hover:-translate-y-0.5">
                <i class="fa-solid fa-search"></i>
            </button>
        </div>
    </form>
</div>

<!-- MENSAJE DE NO RESULTADOS -->
<section class="flex items-center justify-center h-96 w-full bg-purple-100 dark:bg-purple-950 transition-colors duration-300 rounded-lg">
    <div class="text-center px-4 py-8">
        <div class="mb-16 text-purple-500 dark:text-purple-400 font-bold animate-pulse"
             style="font-size: 10rem; line-height: 1;">:(</div>
        <h3 class="text-2xl font-semibold mb-2 text-purple-800 dark:text-purple-100">No se han encontrado plataformas</h3>
        <p class="text-base text-purple-600 dark:text-purple-300">Revisa que lo hayas escrito correctamente</p>
    </div>
</section>

<!-- TARJETAS DE PLATAFORMAS -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    @foreach (var p in Model)
    {
        <div class="bg-white/80 dark:bg-purple-950/80 border border-purple-200 dark:border-purple-800 rounded-xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 backdrop-blur-sm">
            <h3 class="text-xl font-bold text-purple-900 dark:text-purple-100 mb-3">@p.nombrePlataforma</h3>
            <p class="text-purple-700 dark:text-purple-300 mb-4 leading-relaxed">@p.descripcionPlataforma</p>

            <div class="flex items-center justify-between mb-4">
                <span class="text-sm text-purple-500 dark:text-purple-400">Privacidad:</span>
                <span class="text-sm font-medium px-2 py-1 rounded-lg bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-300">
                    @p.privacidadPlataforma
                </span>
            </div>

            @if (p.privacidadPlataforma == "Privado")
            {
                <a href="@Url.Action("UnirsePrivado", "Plataforma", new { id = p.idPlataforma })"
                   class="w-full bg-purple-600 hover:bg-purple-700 text-white text-center py-3 px-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-xl block">
                    <i class="fa-solid fa-key mr-2"></i>
                    Unirse con código
                </a>
            }
            else
            {
                <a href="@Url.Action("UnirsePublico", "Plataforma", new { id = p.idPlataforma })"
                   class="w-full bg-purple-600 hover:bg-purple-700 text-white text-center py-3 px-4 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-md hover:shadow-xl block">
                    <i class="fa-solid fa-users mr-2"></i>
                    Unirse
                </a>
            }
        </div>
    }
</div>
