@model SmartSys.Models.Plataforma
@{
    ViewBag.Title = "Panel de Administración";
}

<div class="max-w-5xl mx-auto p-6">
    <!-- TÍTULO -->
    <h2 class="text-3xl font-extrabold text-purple-900 dark:text-purple-100 mb-6">Panel de Administración</h2>
    <h3 class="text-xl font-semibold text-gray-800 dark:text-gray-200 mb-6">@Model.nombrePlataforma</h3>

    <!-- TARJETA DE INFORMACIÓN GENERAL -->
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-6 border border-purple-100 dark:border-purple-800 transition-all duration-300">
        <h4 class="text-lg font-bold text-purple-700 dark:text-purple-300 mb-4">Información General</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <p><strong>Nombre:</strong> @Model.nombrePlataforma</p>
            <p><strong>Descripción:</strong> @Model.descripcionPlataforma</p>
            <p><strong>Capacidad:</strong> @Model.capacidadMiembros_plataforma miembros</p>
            <p><strong>Privacidad:</strong> @Model.privacidadPlataforma</p>
            <p><strong>Código:</strong> @Model.codigoPlataforma</p>
            <p>
                <strong>Estado:</strong>
                <span class="px-2 py-1 rounded-lg font-medium @(Model.estadoPlataforma == "Activo" ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300" : "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300")">
                    @Model.estadoPlataforma
                </span>
            </p>
        </div>

        <!-- BOTONES DE ACCIÓN -->
        <div class="mt-6 flex flex-wrap gap-3">
            <a href="@Url.Action("EditarPlataforma", "Plataforma", new { id = Model.idPlataforma })"
               class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-transform duration-300 transform hover:-translate-y-0.5">
                Editar Plataforma
            </a>
            <a href="@Url.Action("GestionMiembros", "Plataforma", new { id = Model.idPlataforma })"
               class="px-4 py-2 bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-200 font-semibold rounded-lg border border-purple-300 dark:border-purple-700 shadow-md hover:shadow-lg transition-transform duration-300 transform hover:-translate-y-0.5">
                Gestionar Miembros
            </a>
            <a href="@Url.Action("Contenido", "Plataforma", new { id = Model.idPlataforma })"
               class="px-4 py-2 bg-purple-100 dark:bg-purple-900 text-purple-700 dark:text-purple-200 font-semibold rounded-lg border border-purple-300 dark:border-purple-700 shadow-md hover:shadow-lg transition-transform duration-300 transform hover:-translate-y-0.5">
                Ver Contenido
            </a>
        </div>
    </div>
</div>
