@model IEnumerable<SmartSys.Models.Plataforma>
@{
    ViewBag.Title = "Plataformas del Usuario";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
        Plataformas de @ViewBag.NombreUsuario
    </h2>

    <div class="mb-6">
        <a href="@Url.Action("Index")" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md transition-colors duration-200 font-medium">
            Volver al listado de usuarios
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-md">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Nombre</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Privacidad</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Estado</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Capacidad de Miembros</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var p in Model)
                {
                    <tr class="hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200">
                        <td class="dark:text-white px-4 py-2">@p.nombrePlataforma</td>
                        <td class="dark:text-white px-4 py-2">@p.privacidadPlataforma</td>
                        <td class="dark:text-white px-4 py-2">@p.estadoPlataforma</td>
                        <td class="dark:text-white px-4 py-2">@p.capacidadMiembros_plataforma</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
