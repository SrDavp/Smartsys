@model IEnumerable<SmartSys.Models.Publicaciones>
@{
    ViewBag.Title = "Publicaciones del Usuario";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">
        Publicaciones de @ViewBag.NombreUsuario
    </h2>

    <div class="flex flex-col sm:flex-row sm:justify-between mb-6 gap-4">
        <a href="@Url.Action("Index")" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md transition-colors duration-200 font-medium">
            Volver al listado de usuarios
        </a>

        <form method="get" class="flex flex-col sm:flex-row gap-2 sm:items-center">
            <input type="hidden" name="id" value="@Request["id"]" />
            <input type="text" name="titulo" value="@ViewBag.Titulo" placeholder="Buscar por título"
                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 w-full sm:w-56" />
            <input type="text" name="tipo" value="@ViewBag.Tipo" placeholder="Tipo de publicación"
                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 w-full sm:w-56" />
            <input type="text" name="estado" value="@ViewBag.Estado" placeholder="Estado"
                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 w-full sm:w-56" />
            <input type="date" name="fecha" value="@ViewBag.Fecha"
                   class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-white focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-purple-500 w-full sm:w-56" />
            <button type="submit" class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md transition-colors duration-200">
                Buscar
            </button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-md">
            <thead class="bg-gray-100 dark:bg-gray-700">
                <tr>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Título</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Tipo</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Fecha</th>
                    <th class="px-4 py-2 text-left text-sm font-medium text-gray-700 dark:text-gray-300">Estado</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var pub in Model)
                {
                    <tr class="hover:bg-purple-100 dark:hover:bg-purple-700">
                        <td class="px-4 py-2">@pub.titulo</td>
                        <td class="px-4 py-2">@pub.tipoPublicacion</td>
                        <td class="px-4 py-2">@pub.fechaPublicacion?.ToShortDateString()</td>
                        <td class="px-4 py-2">@pub.estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
