@model SmartSys.Models.Publicaciones
@{
    ViewBag.Title = "Editar Publicación";
}
<h2 class="text-2xl font-bold mb-4">Editar Publicación</h2>
@using (Html.BeginForm("EditarPublicacion", "SuperAdmin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(m => m.idPublicacion)

    <div class="form-group">
        @Html.LabelFor(m => m.titulo)
        @Html.TextBoxFor(m => m.titulo, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.contenido)
        @Html.TextAreaFor(m => m.contenido, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.tipoPublicacion)
        @Html.DropDownListFor(m => m.tipoPublicacion, new SelectList(new[] { "Publicacion", "Tarea", "Anuncio" }, Model.tipoPublicacion), new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.estado)
        @Html.DropDownListFor(m => m.estado, new SelectList(new[] { "Activo", "Inactivo" }, Model.estado), new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Nuevo Archivo Adjunto")
        <input type="file" name="archivoAdjuntoFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary mt-3">Guardar Cambios</button>
}