@model List<SmartSys.Models.PublicacionConUsuario>
@{
    ViewBag.Title = "Publicaciones del Sistema";
}
<h2 class="text-2xl font-bold mb-4">Listado de Publicaciones</h2>

@using (Html.BeginForm("Publicaciones", "SuperAdmin", FormMethod.Get))
{
    <input type="hidden" name="id" value="@ViewBag.PlataformaId" />

    <div class="row mb-4">
        <div class="col-md-2">
            <label for="titulo">Título</label>
            <input type="text" name="titulo" value="@Request["titulo"]" class="form-control" placeholder="Buscar título..." />
        </div>

        <div class="col-md-2">
            <label for="tipo">Tipo</label>
            <input type="text" name="tipo" value="@Request["tipo"]" class="form-control" placeholder="Ej: Publicacion" />
        </div>

        <div class="col-md-2">
            <label for="estado">Estado</label>
            <input type="text" name="estado" value="@Request["estado"]" class="form-control" placeholder="Ej: Activa" />
        </div>

        <div class="col-md-2">
            <label for="usuario">Usuario</label>
            <input type="text" name="usuario" value="@Request["usuario"]" class="form-control" placeholder="Nombre o apellido" />
        </div>

        <div class="col-md-2">
            <label for="fecha">Fecha</label>
            <input type="date" name="fecha" value="@Request["fecha"]" class="form-control" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
        </div>
    </div>
}


<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Imagen</th>
            <th>Título</th>
            <th>Tipo</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Usuario que las publico</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            var pub = item.Publicacion;
            var user = item.Usuario;

            var imagenBase64 = pub.archivoAdjunto != null
                ? "data:image/png;base64," + Convert.ToBase64String(pub.archivoAdjunto)
                : null;

            <tr>
                <td>@pub.idPublicacion</td>
                <td>
                    @if (imagenBase64 != null)
                    {
                        <img src="@imagenBase64" alt="Imagen" style="width: 80px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">Sin imagen</span>
                    }
                </td>
                <td>@pub.titulo</td>
                <td>@pub.tipoPublicacion</td>
                <td>@(pub.fechaPublicacion?.ToShortDateString())</td>
                <td>@pub.estado</td>
                <td>@(user.Nombre + " " + user.Apellido)</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="@Url.Action("EditarPublicacion", new { id = pub.idPublicacion })">Editar</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("EliminarPublicacion", new { id = pub.idPublicacion })" onclick="return confirm('¿Eliminar publicación?')">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
