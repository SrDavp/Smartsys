@model List<SmartSys.Models.Plataforma>
@{
    ViewBag.Title = "Plataformas del Sistema";
}
<h2 class="text-2xl font-bold mb-4">Listado de Plataformas</h2>
<a href="@Url.Action("CrearPlataforma")" class="btn btn-success mb-3">+ Crear Nueva Plataforma</a>
<form method="get" class="mb-4">
    <div class="flex gap-4 items-end">
        <div>
            <label for="busqueda" class="block text-sm font-medium">Buscar por nombre o descripción</label>
            <input type="text" name="busqueda" id="busqueda" value="@ViewBag.Busqueda" class="form-control" />
        </div>
        <div>
            <label for="estado" class="block text-sm font-medium">Estado</label>
            <input type="text" name="estado" id="estado" class="form-control"
                   placeholder="Ej: Activa o Inactiva"
                   value="@(ViewBag.Estado ?? "")" />
        </div>
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Privacidad</th>
            <th>Capacidad</th>
            <th>Código</th>
            <th>Fecha de Creación</th>
            <th>Icono</th>
            <th>Fondo</th>
            <th>Estado</th>
            <th>Acciones</th>
            <th>Publicaciones de la Plataforma</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            var iconoBase64 = p.iconoPlataforma != null ? "data:image/png;base64," + Convert.ToBase64String(p.iconoPlataforma) : null;
            var fondoBase64 = p.fondoPlataforma != null ? "data:image/png;base64," + Convert.ToBase64String(p.fondoPlataforma) : null;
            <tr>
                <td>@p.nombrePlataforma</td>
                <td>@p.descripcionPlataforma</td>
                <td>@p.privacidadPlataforma</td>
                <td>@p.capacidadMiembros_plataforma</td>
                <td>@p.codigoPlataforma</td>
                <td>@p.fechaCreacion.ToShortDateString()</td>
                <td>
                    @if (iconoBase64 != null)
                    {
                        <img src="@iconoBase64" class="w-10 h-10 rounded-full border" />
                    }
                </td>
                <td>
                    @if (fondoBase64 != null)
                    {
                        <img src="@fondoBase64" class="w-16 h-10 border object-cover" />
                    }
                </td>
                <td>@p.estadoPlataforma</td>
                <td>
                    <a class="btn btn-sm btn-primary" href="@Url.Action("EditarPlataforma", new { id = p.idPlataforma })">Editar</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("EliminarPlataforma", new { id = p.idPlataforma })" onclick="return confirm('¿Eliminar plataforma?')">Eliminar</a>
                </td>
                <td>
                    <a href="@Url.Action("Publicaciones", "SuperAdmin", new { id = p.idPlataforma })" class="btn btn-info btn-sm">Ver Publicaciones</a>
                </td>
            </tr>
        }
    </tbody>
</table>