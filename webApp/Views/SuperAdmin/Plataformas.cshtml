@model List<SmartSys.Models.Plataforma>
@{
    ViewBag.Title = "Plataformas del Sistema";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

    <h2 class="text-3xl font-extrabold mb-6 text-purple-700 dark:text-purple-400">
        Listado de Plataformas
    </h2>

    <div class="flex flex-col sm:flex-row sm:justify-between mb-6 gap-4">
        <a href="@Url.Action("CrearPlataforma")"
           class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg shadow-md transition-colors duration-200 font-medium">
            + Crear Nueva Plataforma
        </a>

        <form method="get" class="flex flex-col sm:flex-row gap-2 sm:items-end">
            <div>
                <label for="busqueda" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    Buscar por nombre o descripción
                </label>
                <input type="text" name="busqueda" id="busqueda" value="@ViewBag.Busqueda"
                       class="px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-purple-500 outline-none w-full sm:w-64" />
            </div>
            <div>
                <label for="estado" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    Estado
                </label>
                <input type="text" name="estado" id="estado" placeholder="Ej: Activa o Inactiva"
                       value="@(ViewBag.Estado ?? "")"
                       class="px-3 py-2 border rounded-lg focus:ring-2 focus:ring-purple-400 focus:border-purple-500 outline-none w-full sm:w-48" />
            </div>
            <button type="submit"
                    class="px-4 py-2  text-gray-400 rounded-lg shadow-md transition-colors duration-200">
                Buscar
            </button>
        </form>
    </div>

    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800 rounded-lg shadow-md">
            <thead class="bg-purple-100 dark:bg-purple-700 text-purple-800 dark:text-purple-200 font-semibold">
                <tr>
                    <th class="px-4 py-2">Nombre</th>
                    <th class="px-4 py-2">Descripción</th>
                    <th class="px-4 py-2">Privacidad</th>
                    <th class="px-4 py-2">Capacidad</th>
                    <th class="px-4 py-2">Código</th>
                    <th class="px-4 py-2">Fecha de Creación</th>
                    <th class="px-4 py-2">Icono</th>
                    <th class="px-4 py-2">Fondo</th>
                    <th class="px-4 py-2">Estado</th>
                    <th class="px-4 py-2">Acciones</th>
                    <th class="px-4 py-2">Publicaciones</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
                @foreach (var p in Model)
                {
                    var iconoBase64 = p.iconoPlataforma != null ? "data:image/png;base64," + Convert.ToBase64String(p.iconoPlataforma) : null;
                    var fondoBase64 = p.fondoPlataforma != null ? "data:image/png;base64," + Convert.ToBase64String(p.fondoPlataforma) : null;

                    <tr class="odd:bg-purple-50 even:bg-purple-100 dark:odd:bg-purple-800 dark:even:bg-purple-700 hover:bg-purple-200 dark:hover:bg-purple-600 transition-colors duration-200">
                        <td class="px-4 py-2 font-medium">@p.nombrePlataforma</td>
                        <td class="px-4 py-2">@p.descripcionPlataforma</td>
                        <td class="px-4 py-2">@p.privacidadPlataforma</td>
                        <td class="px-4 py-2">@p.capacidadMiembros_plataforma</td>
                        <td class="px-4 py-2">@p.codigoPlataforma</td>
                        <td class="px-4 py-2">@p.fechaCreacion.ToShortDateString()</td>
                        <td class="px-4 py-2">
                            @if (iconoBase64 != null)
                            {
                                <img src="@iconoBase64" class="w-10 h-10 rounded-full border" />
                            }
                        </td>
                        <td class="px-4 py-2">
                            @if (fondoBase64 != null)
                            {
                                <img src="@fondoBase64" class="w-16 h-10 border object-cover" />
                            }
                        </td>
                        <td class="px-4 py-2">@p.estadoPlataforma</td>
                        <td class="px-4 py-2 space-x-1">
                            <a class="px-2 py-1 bg-yellow-500 hover:bg-yellow-600 text-white text-sm rounded-md transition-colors duration-200"
                               href="@Url.Action("EditarPlataforma", new { id = p.idPlataforma })">Editar</a>
                            <a class="px-2 py-1 bg-red-500 hover:bg-red-600 text-white text-sm rounded-md transition-colors duration-200"
                               href="@Url.Action("EliminarPlataforma", new { id = p.idPlataforma })" onclick="return confirm('¿Eliminar plataforma?')">Eliminar</a>
                        </td>
                        <td class="px-4 py-2">
                            <a class="px-2 py-1 text-gray-400 text-sm rounded-md transition-colors duration-200"
                               href="@Url.Action("Publicaciones", "SuperAdmin", new { id = p.idPlataforma })">Ver Publicaciones</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
