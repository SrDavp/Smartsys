@model IEnumerable<SmartSys.Models.Usuario>
@{
    ViewBag.Title = "Administrar Usuarios";
}

<h2 class="text-2xl font-bold mb-4">Usuarios registrados</h2>

<p>
    <a class="btn btn-success" href="@Url.Action("Crear", "SuperAdmin")">Crear nuevo usuario</a>
</p>
<form method="get" action="@Url.Action("Index", "SuperAdmin")" class="mb-4">
    <input type="text" name="busqueda" value="@ViewBag.Busqueda" placeholder="Buscar usuarios..."
           class="border rounded px-3 py-2 w-full sm:w-1/2" />
    <button type="submit" class="bg-blue-500 text-white px-4 py-2 rounded mt-2 sm:mt-0 sm:ml-2">Buscar</button>
</form>



<table class="table mt-4">
    <thead>
        <tr>
            <th>Foto</th>
            <th>Nombre</th>
            <th>Correo Electronico</th>
            <th>Tipo de Usuario</th>
            <th>Publicaciones</th>
            <th>Plataformas a las que pertenece</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            var fotoBase64 = u.Foto_perfil != null
                ? "data:image/png;base64," + Convert.ToBase64String(u.Foto_perfil)
                : null;
            <tr>
                <td>
                    @if (fotoBase64 != null)
                    {
                        <img src="@fotoBase64" class="w-10 h-10 rounded-full object-cover border" />
                    }
                    else
                    {
                        <span class="text-gray-400">Sin imagen</span>
                    }
                </td>
                <td>@u.Nombre @u.Apellido</td>
                <td>@u.CorreoElectronico</td>
                <td>@u.TipoUsuario</td>
                <td>
                    <a class="btn btn-sm btn-secondary" href="@Url.Action("PublicacionesUsuario", "SuperAdmin", new { id = u.IdUsuario })">Ver</a>

                </td>
                <td>
                    <a class="btn btn-sm btn-info" href="@Url.Action("PlataformasUsuario", "SuperAdmin", new { id = u.IdUsuario })">Ver</a>
                </td>
                <td>
                    <a class="btn btn-sm btn-primary" href="@Url.Action("Editar", new { id = u.IdUsuario })">Editar</a>
                    <a class="btn btn-sm btn-danger" href="@Url.Action("Eliminar", new { id = u.IdUsuario })" onclick="return confirm('¿Eliminar usuario?')">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

