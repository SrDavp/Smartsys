<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - SmartSys</title>

    <!-- Tailwind CSS -->
    <link href="~/Content/tailwind.css" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/css/traductor.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="bg-gray-300 dark:bg-gray-900">

    @{
        Response.Cache.SetCacheability(HttpCacheability.NoCache);
        Response.Cache.SetNoStore();
        Response.Cache.SetExpires(DateTime.UtcNow.AddMinutes(-1));
    }


    <!-- 🧭 Barra de navegación -->
    <nav class=" h-25 bg-white shadow p-4 flex justify-between items-center dark:bg-gray-900">
        @if (Session["UsuarioID"] == null)
        {
            <a href="@Url.Action("Index", "Home")"><img class="w-40 mr-20 dark:invert" src="~/Content/img/logo.png" /></a>
        }
        else if (Session["Tipo"]?.ToString() == "superAdmin")
        {
            <a href="@Url.Action("Index", "SuperAdmin")"><img class="w-40 mr-20 dark:invert" src="~/Content/img/logo.png" /></a>

        }
        else
        {
            <a href="@Url.Action("Index", "Home")"><img class="w-40 mr-20 dark:invert" src="~/Content/img/logo.png" /></a>

        }
        <ul class="flex space-x-4 justify-center items-center">
            @if (Session["UsuarioID"] == null)
            {
                <li><a href="@Url.Action("About", "Home")" class=" text-xl text-purple-300 hover:text-purple-500">Sobre SmarSys</a></li>
                <li><a href="@Url.Action("Contacto", "Home")" class=" text-xl text-purple-300 hover:text-purple-500">Contacto</a></li>
                <li><a href="@Url.Action("Login", "Account")" class=" text-xl text-purple-300 hover:text-purple-500">Iniciar Sesión</a></li>
                <li><a href="@Url.Action("Registro", "Account")" class="text-xl text-purple-300 hover:text-purple-500">Registrarse</a></li>
            }
            else if (Session["Tipo"]?.ToString() == "superAdmin")
            {
                <li><a href="@Url.Action("Index", "SuperAdmin")" class="text-xl text-purple-300 hover:text-purple-500">Usuarios</a></li>
                <li><a href="@Url.Action("Plataformas", "SuperAdmin")" class="text-xl text-purple-300 hover:text-purple-500">Plataformas</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="text-xl text-purple-300 hover:text-purple-500">Cerrar sesión</a></li>
            }
            else
            {
                <li class="text-xl text-purple-300 hover:text-purple-500">Hola, @Session["Nombre"]</li>
                <li><a href="@Url.Action("Perfil", "Account")" class="text-xl text-purple-300 hover:text-purple-500">Perfil</a></li>
                <li><a href="@Url.Action("CrearPlataforma", "Plataforma")" class="text-xl text-purple-300 hover:text-purple-500">Crear Plataforma</a></li>
                <li><a href="@Url.Action("MisPlataformas", "Plataforma")" class="text-xl text-purple-300 hover:text-purple-500">Mis Plataformas</a></li>
                <li><a href="@Url.Action("Logout", "Account")" class="text-xl text-purple-300 hover:text-purple-500">Cerrar sesión</a></li>
                <li><a href="@Url.Action("Explorar", "Plataforma")" class="text-xl text-purple-300 hover:text-purple-500">Explorar Plataformas</a></li>
                @*<li><a href="@Url.Action("Index", "Chat")" class="text-xl text-purple-300 hover:text-purple-500">Chat</a></li>*@
            }
            <li>
                <button class="hidden dark:inline-block dark:text-white" id="btnLight"><i class="fa-solid fa-sun"></i></button>
                <button class="dark:hidden inline-block" id="btnDark"><i class="fa-solid fa-moon"></i></button>
            </li>
            <li><div class="text-color" id="google_translate_element"></div></li>
        </ul>
    </nav>

    <!-- 📄 Contenido principal -->
    <div class="container">
        @RenderBody()
    </div>
    @if (Session["UsuarioID"] == null)
    {
        <!-- Footer -->
        <footer class="bg-gray-900 text-white py-16">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <div class="col-span-1 md:col-span-2">
                        <img class="w-50" src="~/Content/img/logo-dark.png" />
                        <p class="text-gray-300 mb-6 leading-relaxed">
                            La plataforma más intuitiva para crear sitios web profesionales. Transforma tus ideas en realidad digital sin límites ni complicaciones.
                        </p>
                        <div class="flex space-x-4">
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-twitter"></i>
                            </a>
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                        </div>
                    </div>

                    <div>
                        <h4 class="font-semibold mb-4">Producto</h4>
                        <ul class="space-y-2 text-gray-300">
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Características</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Plantillas</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Precios</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Actualizaciones</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="font-semibold mb-4">Soporte</h4>
                        <ul class="space-y-2 text-gray-300">
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Centro de Ayuda</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Contacto</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Tutoriales</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">API Docs</a></li>
                        </ul>
                    </div>
                </div>

                <div class="border-t border-gray-700 mt-12 pt-8 text-center text-gray-400">
                    <p>
                        &copy; 2025 SmartSys. Todos los derechos reservados. |
                        <a href="#" class="hover:text-purple-400 transition-colors">Política de Privacidad</a> |
                        <a href="#" class="hover:text-purple-400 transition-colors">Términos de Servicio</a>
                    </p>
                </div>
            </div>
        </footer>
    }
    else if (Session["Tipo"]?.ToString() == "superAdmin")
    {
        <div></div>
    }
    else
    {
        <!-- Footer -->
        <footer class="bg-gray-900 text-white py-16">
            <div class="container mx-auto px-6">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <div class="col-span-1 md:col-span-2">
                        <img class="w-50" src="~/Content/img/logo-dark.png" />
                        <p class="text-gray-300 mb-6 leading-relaxed">
                            La plataforma más intuitiva para crear sitios web profesionales. Transforma tus ideas en realidad digital sin límites ni complicaciones.
                        </p>
                        <div class="flex space-x-4">
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-facebook-f"></i>
                            </a>
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-twitter"></i>
                            </a>
                            <a href="#" class="w-10 h-10 bg-purple-600 rounded-full flex items-center justify-center hover:bg-purple-700 transition-colors">
                                <i class="fa-brands fa-instagram"></i>
                            </a>
                        </div>
                    </div>

                    <div>
                        <h4 class="font-semibold mb-4">Producto</h4>
                        <ul class="space-y-2 text-gray-300">
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Características</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Plantillas</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Precios</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Actualizaciones</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="font-semibold mb-4">Soporte</h4>
                        <ul class="space-y-2 text-gray-300">
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Centro de Ayuda</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Contacto</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">Tutoriales</a></li>
                            <li><a href="#" class="hover:text-purple-400 transition-colors">API Docs</a></li>
                        </ul>
                    </div>
                </div>

                <div class="border-t border-gray-700 mt-12 pt-8 text-center text-gray-400">
                    <p>
                        &copy; 2025 SmartSys. Todos los derechos reservados. |
                        <a href="#" class="hover:text-purple-400 transition-colors">Política de Privacidad</a> |
                        <a href="#" class="hover:text-purple-400 transition-colors">Términos de Servicio</a>
                    </p>
                </div>
            </div>
        </footer>
    }
    <script src="~/Content/js/dark.js"></script>
    <script src="~/Content/js/traductor.js"></script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

</body>
</html>
